---
import Base from '../layouts/Base.astro';
import S01Hero from '../components/S01Hero.astro';
import S02Problema from '../components/S02Problema.astro';
import S03Rezultatul from '../components/S03Rezultatul.astro';
import S04PentruCine from '../components/S04PentruCine.astro';
import S05InainteDupa from '../components/S05InainteDupa.astro';
import S06CeFacem from '../components/S06CeFacem.astro';
import S07NuDoarTeorie from '../components/S07NuDoarTeorie.astro';
import S08CePleciCuTine from '../components/S08CePleciCuTine.astro';
import S09UseCases from '../components/S09UseCases.astro';
import S10Deeplogic from '../components/S10Deeplogic.astro';
import S11Facilitator from '../components/S11Facilitator.astro';
import S12Precedent from '../components/S12Precedent.astro';
import S13Detalii from '../components/S13Detalii.astro';
import S14DeCeGratuit from '../components/S14DeCeGratuit.astro';
import S15Faq from '../components/S15Faq.astro';
import S16Inscriere from '../components/S16Inscriere.astro';
import S17Footer from '../components/S17Footer.astro';
import CtaSticky from '../components/CtaSticky.astro';
import ControlerCarduri from '../components/ControlerCarduri.astro';
import Labirint from '../components/Labirint.astro';

/**
 * Prerandată integral. Nimic din §01–§17 nu e dinamic — formularul face POST
 * către o rută separată, randată la cerere. Pagina se servește de pe CDN-ul
 * Cloudflare, ceea ce contează pe 4G, în browserul in-app din WhatsApp.
 */
export const prerender = true;
---

<Base>
  {/*
    Labirintul — un singur strat `position: fixed` pentru toată pagina (v5),
    care conține banda, cele 16 checkpointuri și subiectul. Înlocuiește cele
    16 instanțe de <Campul>, câte una per card. Ordinea în DOM nu contează
    pentru randare (z-index explicit), dar contează pentru parsare:
    payload-ul JSON al labirintului trebuie să existe înainte ca
    ControlerCarduri (randat ultimul) să-l citească.
  */}
  <Labirint />

  <S01Hero />

  <main id="continut">
    <S02Problema />
    <S03Rezultatul />
    <S04PentruCine />
    <S05InainteDupa />
    <S06CeFacem />
    <S07NuDoarTeorie />
    <S08CePleciCuTine />
    <S09UseCases />
    <S10Deeplogic />
    <S11Facilitator />
    <S12Precedent />
    <S13Detalii />
    <S14DeCeGratuit />
    <S15Faq />
    <S16Inscriere />
  </main>

  <S17Footer />
  <CtaSticky />

  {/*
    Controllerul de carduri — doar pe pagina asta: layout-ul de card + hijack
    e o suprascriere pentru ACEST layer (vezi docs/DECIZII.md, „Layout
    «cartonaș» + scroll hijack real"), nu un principiu general al
    layout-ului Base.astro, care rămâne „zero scroll deturnat" pentru orice
    altă pagină/interacțiune viitoare.

    Randat ULTIMUL, deliberat: scriptul lui `is:inline` face
    `document.querySelectorAll('[data-card]')` la parsare — dacă ar rula
    ÎNAINTE ca hero/secțiunile să fie în DOM, ar prinde o listă goală și ar
    ieși imediat (`if (cards.length === 0) return`), fără să mai atașeze
    niciun listener. Nu randează nimic vizibil, deci poziția nu are efect
    vizual — doar pe ordinea de execuție.
  */}
  <ControlerCarduri />
</Base>
