---
import Base from '../layouts/Base.astro';
import S01Hero from '../components/S01Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import S02Problema from '../components/S02Problema.astro';
import Agravare from '../components/Agravare.astro';
import Solutie from '../components/Solutie.astro';
import S06CeFacem from '../components/S06CeFacem.astro';
import S11Facilitator from '../components/S11Facilitator.astro';
import S04PentruCine from '../components/S04PentruCine.astro';
import S03Rezultatul from '../components/S03Rezultatul.astro';
import S15Faq from '../components/S15Faq.astro';
import S16Inscriere from '../components/S16Inscriere.astro';
import S17Footer from '../components/S17Footer.astro';
import CtaFloating from '../components/CtaFloating.astro';
import DialogInscriere from '../components/DialogInscriere.astro';

/**
 * Prerandată integral. Nimic din pagină nu e dinamic — formularul face POST
 * către o rută separată, randată la cerere. Pagina se servește de pe CDN-ul
 * Cloudflare, ceea ce contează pe 4G, în browserul in-app din WhatsApp.
 *
 * Ordinea (pivot de structură, 2026-09-02): Hero → Trust bar → Problemă →
 * Agravare → Soluție → [metodologia, păstrată — vezi comentariul din
 * copy.ts] → Facilitator → Cui i se adresează/nu → Ce rezultat promitem →
 * FAQ → CTA final. Numele fișierelor de componente (`S0X...`) sunt
 * parțial istorice — ordinea reală e cea din markup-ul de mai jos, nu
 * numărul din nume (același precedent ca la pivotul de narativă, aceeași zi).
 */
export const prerender = true;
---

<Base scarcity motion depth>
  <S01Hero />
  <TrustBar />

  <main id="continut">
    <S02Problema />
    <Agravare />
    <Solutie />
    <S06CeFacem />
    <S11Facilitator />
    <S04PentruCine />
    <S03Rezultatul />
    <S15Faq />
    <S16Inscriere />
  </main>

  <S17Footer />
  <CtaFloating />
  <DialogInscriere />
</Base>
