---
import { EVENIMENT, scarcity } from '../content/copy';

/**
 * Bara fixă de scarcity — decizie explicită a lui Ciprian (2026-08-31),
 * reversare a interdicției din CLAUDE.md („Nu punem contor live"). Vezi
 * comentariul din CLAUDE.md §1 pentru istoricul deciziei.
 *
 * Regula care rămâne literă de lege, din sursa PRIMUL PAS: „fără deficit
 * fals; afișează doar date reale". De-asta bara nu are un fallback „fals
 * plin" — fără JS sau dacă fetch-ul către /api/locuri-disponibile eșuează,
 * arată STRICT informația statică, verificabilă din altă parte a paginii
 * (data, ora, capacitatea maximă) — niciodată un număr de locuri ghicit.
 *
 * Countdown-ul e calculat integral client-side: pagina e prerandată static
 * (`export const prerender = true`, index.astro), deci orice cifră „scrisă"
 * la build ar fi deja greșită la câteva ore de la deploy.
 */
---

<div id="bara-scarcity" class="bara-scarcity" role="status" aria-live="off">
  <p class="continut" data-continut>{scarcity.fallbackStatic}</p>
</div>

<script is:inline define:vars={{ dataStart: '2026-09-16T14:00:00+03:00', maximeStatic: EVENIMENT.capacitate, etichetaLocuri: scarcity.etichetaLocuri, etichetaCountdown: scarcity.etichetaCountdown, mesajPlin: scarcity.plin, textAInceput: scarcity.aInceput, etichetaDisponibil: scarcity.etichetaDisponibil }}>
  (() => {
    const bara = document.getElementById('bara-scarcity');
    const continut = bara?.querySelector('[data-continut]');
    if (!bara || !continut) return;

    const tinta = new Date(dataStart).getTime();

    /**
     * Interpolare RGB liniară, pe raportul de ocupare (0 = gol, 1 = plin).
     * Fundalul barei a revenit la negru (2026-09-02, a treia rundă —
     * „lasă header-ul negru, doar textul roșu") — gradientul revine la
     * varianta pentru fundal închis: alb → `--eroare-clar` (#E08585,
     * 5.92:1 pe `--bg-inchis`, deja verificat).
     *   - insigna din dialog (fundal alb): `--secundar` → `--eroare`
     *     (#9E4B4B, 5.90:1 pe alb — deja verificat de `npm run contrast`).
     */
    function culoareOcupare(ocupare, start, stop) {
      const t = Math.max(0, Math.min(1, ocupare));
      const rgb = start.map((c, i) => Math.round(c + t * (stop[i] - c)));
      return `rgb(${rgb.join(',')})`;
    }
    const GRADIENT_PE_INCHIS = [[255, 255, 255], [224, 133, 133]]; // alb → var(--eroare-clar)
    const GRADIENT_PE_ALB = [[47, 79, 79], [158, 75, 75]]; // var(--secundar) → var(--eroare)

    /**
     * Fix (audit impeccable, 2026-09-01): întorcea doar cifra/eticheta
     * countdown-ului, iar apelantul lipea necondiționat sufixul static
     * „până la începere" după ea — după ora de start, cu locuri încă
     * disponibile (posibil, dacă bufferul soft nu s-a umplut), bara afișa
     * „a început până la începere". Acum întoarce fraza completă, ca
     * apelantul să nu mai construiască o propoziție din bucăți.
     */
    function formatCountdown(ms) {
      if (ms <= 0) return textAInceput;
      const zile = Math.floor(ms / 86400000);
      const ore = Math.floor((ms % 86400000) / 3600000);
      const minute = Math.floor((ms % 3600000) / 60000);
      if (zile > 0) return `${zile}z ${ore}h ${etichetaCountdown}`;
      if (ore > 0) return `${ore}h ${minute}m ${etichetaCountdown}`;
      const secunde = Math.floor((ms % 60000) / 1000);
      return `${minute}m ${secunde}s ${etichetaCountdown}`;
    }

    let ramase = null;
    // Fix (audit impeccable, 2026-09-01): răspunsul de la /api/locuri-disponibile
    // include `maxime`, dar bara îl ignora și folosea mereu constanta de la
    // build (`maximeStatic`, din EVENIMENT.capacitate) — dacă cele două ar
    // ajunge vreodată să difere (capacitatea schimbată în bază, dar uitată
    // în copy.ts), bara ar minți încrezător cu numărul vechi. Actualizat la
    // fiecare fetch reușit; `maximeStatic` rămâne doar fallback-ul dinaintea
    // primului răspuns.
    let maxime = maximeStatic;

    /**
     * Rândul de locuri live din formularul de înscriere (DialogInscriere.astro)
     * — aceeași sursă de date ca bara, aceeași regulă de onestitate: rămâne
     * `hidden` până există un răspuns real de la API.
     */
    function randeazaLocuriDinFormular() {
      const tinte = document.querySelectorAll('[data-locuri-live]');
      if (!tinte.length || ramase === null) return;

      const text =
        ramase <= 0
          ? mesajPlin
          : `Mai sunt ${ramase} ${etichetaLocuri} ${maxime}.`;
      const culoare = ramase <= 0 ? 'rgb(158,75,75)' : culoareOcupare(1 - ramase / maxime, ...GRADIENT_PE_ALB);

      tinte.forEach((el) => {
        el.textContent = text;
        el.style.color = culoare;
        el.hidden = false;
      });
    }

    function randeaza() {
      const acum = Date.now();
      const ramasCountdown = formatCountdown(tinta - acum);
      if (ramase === null) return; // încă n-a răspuns niciun fetch

      if (ramase <= 0) {
        continut.textContent = mesajPlin;
        bara.style.color = '#E08585';
      } else {
        continut.textContent = `${ramase} ${etichetaLocuri} ${maxime} · ${ramasCountdown}`;
        bara.style.color = culoareOcupare(1 - ramase / maxime, ...GRADIENT_PE_INCHIS);
      }

      randeazaLocuriDinFormular();
    }

    /**
     * Un singur fetch la încărcare NU e „live" — cineva care ține pagina
     * deschisă în timp ce se mai înscriu oameni ar vedea un număr înghețat
     * la valoarea de acum 20 de minute. Reapelat periodic (nu doar o dată)
     * și la revenirea în tab (`visibilitychange`), ca numărul afișat să nu
     * rămână niciodată mai vechi decât ce vede vizitatorul pe ecran.
     */
    function preiaLocuri() {
      return fetch('/api/locuri-disponibile', { headers: { Accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
        .then((date) => {
          if (typeof date.ramase !== 'number') return;
          ramase = date.ramase;
          if (typeof date.maxime === 'number' && date.maxime > 0) maxime = date.maxime;
          randeaza();

          // Rândul de sub fiecare CTA — vezi Cta.astro/CtaFloating.astro.
          // Ascuns implicit, completat/actualizat la fiecare fetch reușit cu
          // date reale. Format „Disponibil 25/30" — cerut explicit (2026-09-02).
          document.querySelectorAll('[data-locuri-cta]').forEach((el) => {
            el.textContent = `${etichetaDisponibil} ${ramase}/${maxime}`;
            el.hidden = false;
          });
        })
        .catch(() => {
          // Fetch eșuat: bara rămâne pe ce știe deja (fallback-ul static, sau
          // ultima valoare reală primită). Niciun număr ghicit, niciodată.
        });
    }

    preiaLocuri();
    // 20s: suficient de des cât să simtă „live" pe durata unei vizite, și
    // PESTE pragul de 15s al `Cache-Control` de pe /api/locuri-disponibile
    // (comentariu corectat — audit impeccable, 2026-09-01: varianta veche
    // spunea „sub", exact invers) — fiecare interval e mai lung decât
    // durata de viață a cache-ului browserului, deci fiecare apel ajunge
    // efectiv la bază, nu se servește dintr-un răspuns deja expirat.
    setInterval(preiaLocuri, 20000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') preiaLocuri();
    });

    setInterval(randeaza, 1000);
  })();
</script>

<style>
  .bara-scarcity {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    height: var(--h-bara-scarcity);
    /*
     * Revenit la negru (2026-09-02, a treia rundă — „lasă header-ul negru,
     * doar textul roșu"), dar cu sticlă mată, nu opac plat: fundal
     * translucid + blur, ca butonul flotant. Text implicit alb (capătul
     * „gol" al gradientului calculat de script), deja 15.83:1 pe
     * `--bg-inchis` opac — pe versiunea translucidă marja scade puțin, dar
     * rămâne masiv peste prag (fundalul e tot închis dedesubt, pagina
     * pornește pe alb).
     */
    background: rgba(27, 36, 38, 0.82);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-pe-inchis);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--lat);
    /* Culoarea de mai sus e setată inline de script, pe raportul de ocupare
       real — tranziția face schimbarea vizibilă, nu instantanee. */
    transition: color 400ms ease;
  }

  .continut {
    font-family: var(--font-mono);
    font-size: var(--t-mic);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
</style>
