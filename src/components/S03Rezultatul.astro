---
import { rezultatul } from '../content/copy';
import Sectiune from './Sectiune.astro';
import Cta from './Cta.astro';
---

{/*
  Extinsă la pivotul de structură (2026-09-02) — absoarbe fostul §12
  „Precedent" (20% context / 80% lucru, acum `cumLucram`) și conținut nou
  din v4 („de ce să mai chemi pe cineva", `chemaCineva`). CTA repetat la
  final: singurul repetaj din mijlocul paginii, după cel mai „cald" moment.

  Retrasă parțial (2026-09-09, D83) — fostul `h2` + lista de 4 livrabile +
  blocul „Ce nu îți promit" au dispărut, cerut explicit. `cumLucram.h3`
  („Cum lucrăm") a preluat rolul de heading `h2` al secțiunii — fără el,
  primul heading rămas ar fi fost un `h3` orfan, fără `h2` părinte în
  aceeași secțiune. Detalii complete în `copy.ts`, chiar deasupra
  exportului `rezultatul`.
*/}
<Sectiune id="rezultatul" latime="larg">
  <h2 data-reveal>{rezultatul.cumLucram.h3}</h2>
  <p class="format" data-reveal>{rezultatul.cumLucram.intro}</p>
  {rezultatul.cumLucram.corp.map((p) => (
    <p data-reveal>{p}</p>
  ))}
  <ul class="lista-simpla">
    {rezultatul.cumLucram.lista.map((l) => (
      <li data-reveal>{l}</li>
    ))}
  </ul>
  {rezultatul.cumLucram.outro.map((p) => (
    <p class="outro" data-reveal>{p}</p>
  ))}

  <div class="sub-bloc">
    <h3 data-reveal>{rezultatul.chemaCineva.h3}</h3>
    {rezultatul.chemaCineva.corp.map((p) => (
      <p data-reveal>{p}</p>
    ))}
  </div>

  <Cta spatiuSus />
</Sectiune>

<style>
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  h3 {
    font-size: var(--t-h3);
    margin-bottom: var(--sp-sm);
  }

  .sub-bloc {
    margin-top: var(--sp-xl);
    padding-top: var(--sp-lg);
    border-top: 1px solid rgba(47, 79, 79, 0.18);
    display: grid;
    gap: var(--sp-xs);
    max-width: var(--max-proza);
  }

  .format {
    font-weight: 600;
  }

  .lista-simpla {
    list-style: none;
    padding: 0;
    margin: var(--sp-xs) 0;
    display: grid;
    gap: var(--sp-2xs);
  }

  .lista-simpla li {
    display: grid;
    /* 1.1rem, nu 1.25rem — bulina e mai îngustă decât fostul em-dash,
       aceeași corecție ca la §02/§05/§08. */
    grid-template-columns: 1.1rem 1fr;
    align-items: baseline;
    color: var(--text-muted);
  }

  /* Bulină (`•`), nu em-dash — §09 era ultima secțiune rămasă pe marcajul
     vechi (2026-09-09), acum aliniată cu tot restul paginii. */
  .lista-simpla li::before {
    content: '•';
    color: var(--accent-decor);
    font-size: 1.15em;
    line-height: 1;
  }

  .outro {
    margin-top: var(--sp-xs);
  }
</style>
