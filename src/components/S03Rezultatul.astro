---
import { rezultatul } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

<Sectiune id="rezultatul">
  <h2>{rezultatul.h2}</h2>

  <ol class="lista">
    {rezultatul.lista.map((item, i) => (
      <li>
        <span class="numar" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="text">
          <strong>{item.titlu}</strong>
          <span class="sub">{item.corp}</span>
        </span>
      </li>
    ))}
  </ol>

  {/*
    Blocul „Ce NU vei ști" e obligatoriu. E singura formă de credibilitate care
    funcționează la un om saturat de promisiuni.
    Stilizare deliberată: fundal secundar, FĂRĂ chenar roșu și FĂRĂ iconiță de
    avertizare. E onestitate, nu alertă — dacă arată a warning, se citește ca
    un disclaimer legal și își pierde efectul.
  */}
  <aside class="granita">
    <h3>{rezultatul.granita.h3}</h3>
    {rezultatul.granita.corp.map((p) => (
      <p>{p}</p>
    ))}
  </aside>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  .lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-md);
  }

  .lista li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--sp-sm);
    align-items: start;
  }

  .numar {
    font-family: var(--font-mono);
    /*
     * Fix de contrast (audit impeccable, 2026-09-01) — comentariul vechi
     * invoca SC 1.4.11 („componentă non-text", prag 3:1) ca să justifice
     * `--accent-decor` la `--t-corp` (17-19px). Discutabil: un numeral
     * randat ca text literal, citit ca informație („al treilea din cinci"),
     * e text sub SC 1.4.3, nu o componentă grafică de UI — pragul corect e
     * 4.5:1 (sau 3:1 doar dacă ≥24px, exact regula scrisă pe token în
     * tokens.css). Aliniat cu S06/S08, care au primit același fix: mărit
     * peste 24px, ca să nu mai depindă de o interpretare contestabilă.
     */
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    color: var(--accent-decor);
    font-weight: 500;
    padding-top: 0.15em;
  }

  .text {
    display: grid;
    gap: var(--sp-2xs);
  }

  .text strong {
    font-family: var(--font-titlu);
    font-weight: 600;
    line-height: var(--lh-normal);
  }

  .sub {
    color: var(--text-muted);
  }

  .granita {
    margin-top: var(--sp-lg);
    background: var(--bg-secundar);
    /* Fix de contrast — vezi tokens.css `--text-muted-pe-secundar`. */
    --text-muted: var(--text-muted-pe-secundar);
    padding: var(--sp-md);
    border-radius: var(--radius-lg);
    display: grid;
    gap: var(--sp-sm);
  }

  .granita h3 {
    font-size: var(--t-h3);
  }
</style>
