---
import { cePleciCuTine } from '../content/copy';
import Sectiune from './Sectiune.astro';
import Cta from './Cta.astro';

/** §08 — scena „harta" (momentul-semnătură). Vezi docs/design/storyboard.json. */
const NUME_EL = [
  'item-harta-scrisa',
  'item-document-24h',
  'item-structura-prompt',
  'item-regula-confidentialitate',
  'item-cheat-sheet',
];
---

{/*
  A doua cea mai importantă secțiune. Răspunsul direct la „am mai fost la unul
  și n-am plecat cu nimic". Nu se taie la mobil. Momentul-semnătură al paginii:
  cele cinci lucruri separate se asamblează într-un singur obiect concret —
  răspunsul literal la „n-ai o hartă" din §02.

  Pe alb, deliberat — nu pe registrul întunecat folosit până acum (28 august).
  Greutatea livrabilului vine din scară și spațiere, nu din inversare de
  culoare: un al doilea moment întunecat, chiar la rezoluția promisă de brief
  („liniștit"), ar repeta zgomotul din §02 exact unde pagina trebuie să se
  calmeze. Bugetul de design al paginii se cheltuiește AICI. ITEM 5
  (cheat-sheet tipărit) vine din D7.
*/}
<Sectiune id="ce-pleci-cu-tine" latime="larg" scene="harta">
  <div class="cap">
    <h2>{cePleciCuTine.h2}</h2>
    <p class="numar-total">
      <span>{cePleciCuTine.itemi.length}</span> lucruri, nu notițe
    </p>
  </div>

  {/*
    h3 e frate cu `.corp`, nu copil.

    Varianta cu `display: contents` pe `.corp` arunca al doilea paragraf într-un
    rând de grid nou, iar `gap`-ul dintre rânduri devenea o gaură de 3rem în
    mijlocul livrabilului. Trei coloane reale, trei elemente reale — fără trucuri.

    `data-el="harta-asamblata"` stă pe container: cele cinci `.item` (fiecare cu
    propriul `data-el`) converg spre el pe măsură ce intră în ecran; odată
    așezate, containerul însuși se așază la opacitate/scară completă — „click"-ul
    de asamblare. `.bataie-latch` e o bară discretă, NU scrubuită (vezi
    MotionEngine): se aprinde o singură dată, cu histerezis, nu urmărește
    scroll-ul cadru cu cadru — exact fixul pentru eroarea de flash/strobe
    găsită în explorarea abandonată din 29-31 august.
  */}
  <div class="itemi" data-el="harta-asamblata">
    {/*
      Profunzime, nu decor: un glow static (blur fix, fără imagine) care se
      mișcă mai încet decât piesele care se asamblează deasupra lui — paralaxă
      pe un singur strat, `transform` pur, sub conținut (z-index -1). Ancorează
      vizual asamblarea, nu o ilustrează. `reveal: 1` în MotionEngine — spre
      deosebire de restul elementelor scenei, NU se așază și se oprește:
      urmărește scroll-ul continuu, cât timp scena e vizibilă.
    */}
    <div class="profunzime" data-el="harta-profunzime" aria-hidden="true"></div>
    <div class="bataie-latch" data-el="bataie-latch" aria-hidden="true"></div>
    {cePleciCuTine.itemi.map((item, i) => (
      <article class="item" data-el={NUME_EL[i]}>
        <p class="numar" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
        <h3>{item.titlu}</h3>
        <div class="corp">
          {item.corp.map((p) => <p>{p}</p>)}
        </div>
      </article>
    ))}
  </div>

  <Cta spatiuSus />
</Sectiune>

<style>
  .cap {
    display: grid;
    gap: var(--sp-xs);
    margin-bottom: var(--sp-lg);
  }

  @media (min-width: 48rem) {
    .cap {
      grid-template-columns: 1fr auto;
      align-items: baseline;
      gap: var(--sp-lg);
    }
  }

  h2 {
    font-size: var(--t-statement);
    max-width: 16ch;
  }

  .numar-total {
    font-family: var(--font-mono);
    font-size: var(--t-mic);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent);
  }

  .numar-total span {
    font-size: var(--t-corp-lg);
    font-weight: 500;
  }

  .itemi {
    position: relative;
    display: grid;
    gap: 0;
    /* Linii de câmp, nu carduri — limbajul de document de lucru pe care îl
       promite pagina, nu o listă de feature-uri. */
    border-top: 1px solid rgba(47, 79, 79, 0.18);
  }

  .profunzime {
    position: absolute;
    top: 10%;
    inset-inline: 0;
    margin-inline: auto;
    width: min(34rem, 90%);
    height: 60%;
    background: radial-gradient(closest-side, var(--accent-decor), transparent 72%);
    opacity: 0.08;
    filter: blur(48px);
    z-index: -1;
    pointer-events: none;
  }

  .bataie-latch {
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--accent-decor);
    opacity: 0;
    transform-origin: left;
    transform: scaleX(0);
    transition: opacity 400ms cubic-bezier(0.22, 1, 0.36, 1), transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bataie-latch[data-latched='true'] {
    opacity: 0.55;
    transform: scaleX(1);
  }

  .item {
    display: grid;
    /* Mobil: numărul pe stânga, titlul și descrierea stivuite pe coloana 2. */
    grid-template-columns: 2.25rem 1fr;
    column-gap: var(--sp-md);
    row-gap: var(--sp-xs);
    align-items: start;
    padding-block: var(--sp-md);
    border-bottom: 1px solid rgba(47, 79, 79, 0.18);
  }

  .item h3,
  .item .corp {
    grid-column: 2;
  }

  @media (min-width: 52rem) {
    .item {
      /* Desktop: trei coloane reale. Titlurile se scanează pe verticală fără
         să citești descrierile — ăsta e scopul secțiunii, cinci livrabile
         concrete, vizibile dintr-o privire. */
      grid-template-columns: 3rem minmax(0, 20ch) minmax(0, 1fr);
      column-gap: var(--sp-xl);
      align-items: baseline;
    }
    .item h3 {
      grid-column: 2;
    }
    .item .corp {
      grid-column: 3;
    }
  }

  .numar {
    font-family: var(--font-mono);
    font-size: var(--t-corp);
    font-weight: 500;
    color: var(--accent-decor);
    padding-top: 0.15em;
    grid-row: 1;
  }

  .corp {
    display: grid;
    gap: var(--sp-xs);
  }

  h3 {
    font-size: var(--t-corp-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: var(--lh-normal);
  }
</style>
