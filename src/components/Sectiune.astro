---
interface Props {
  id?: string;
  /**
   * `secundar` = #E4E7E7. `inchis` = #1B2426.
   *
   * Registrul închis nu e un pattern care alternează — o singură secțiune în
   * toată pagina (vacarmul din §02), aleasă pentru sens. Folosit ritmic,
   * ar deveni decor și și-ar pierde greutatea.
   */
  fundal?: 'primar' | 'secundar' | 'inchis';
  /** Lățimea conținutului: `proza` pentru text lung, `larg` pentru tabele/grid. */
  latime?: 'proza' | 'larg';
  clasa?: string;
  /**
   * Fade + ridicare la intrarea în viewport (pivot 2026-09-02, `depth` prop
   * din Base.astro — vezi `[data-reveal]` din tokens.css). Implicit `true`:
   * aproape toată pagina îl vrea acum. Excepția e S06CeFacem.astro, care
   * dezactivează asta explicit — GSAP-ul lui deja animă individual cei cinci
   * pași; un fade+ridicare pe TOT conținutul pinat peste aia ar fi redundant
   * și ar putea intra în conflict vizual cu pin-ul.
   */
  reveal?: boolean;
}
const { id, fundal = 'primar', latime = 'proza', clasa = '', reveal = true } = Astro.props;
---

<section id={id} class:list={['sectiune', fundal]}>
  <div class:list={['continut', latime, clasa]} data-reveal={reveal || null}><slot /></div>
</section>

<style>
  .sectiune {
    padding-block: var(--sp-2xl);
    padding-inline: var(--lat);
    /* Delimitare clară între secțiuni — cerută explicit (2026-09-02): o
       bară subțire, nu doar spațiere, ca granița să se vadă indiferent de
       cât de aproape sunt fundalurile a două secțiuni consecutive. */
    border-top: 1px solid rgba(47, 79, 79, 0.12);
  }

  /* Prima secțiune din flux — TrustBar (fundal secundar) e deasupra, deci
     bara ar dubla granița deja vizibilă dintre alb și gri. */
  .sectiune:first-child {
    border-top: none;
  }

  .sectiune.secundar {
    background: var(--bg-secundar);
    /*
     * Fix de contrast preexistent (v4, decis de Ciprian): `--text-muted`
     * `#637474` dă 3.94:1 pe `#E4E7E7` — sub AA. Redefinit AICI, o singură
     * dată, în loc de editat în fiecare regulă `color:` din §05/§13:
     * `--text-muted` e o proprietate moștenită, deci tot ce trăiește în
     * registrul secundar primește automat valoarea corectă, inclusiv o
     * componentă viitoare care încă nu există. Vezi tokens.css pentru cifre.
     */
    --text-muted: var(--text-muted-pe-secundar);
  }

  .sectiune.inchis {
    background: var(--bg-inchis);
    color: var(--text-pe-inchis-muted);
    /* Secțiunea închisă primește mai mult aer: pe întuneric, aceeași
       spațiere arată mai strânsă decât e. */
    padding-block: calc(var(--sp-2xl) * 1.15);
  }

  .continut {
    margin-inline: auto;
    position: relative;
  }
  .continut.proza {
    max-width: var(--max-proza);
  }
  .continut.larg {
    max-width: var(--max-continut);
  }
</style>

<style is:global>
  /* Titlurile din secțiunile închise trec pe alb pur; corpul rămâne pe gri
     deschis. Global, pentru că elementele vin din componenta copil, iar CSS-ul
     scoped al Astro nu traversează granița de componentă. */
  .sectiune.inchis :is(h2, h3, strong) {
    color: var(--text-pe-inchis);
  }
  .sectiune.inchis a:not(.cta) {
    color: var(--accent-clar);
  }
</style>
