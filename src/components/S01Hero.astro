---
import { hero, EVENIMENT } from '../content/copy';
import Cta from './Cta.astro';
---

<header class="hero">
  <div class="continut">
    <p class="eyebrow">{hero.eyebrow}</p>

    {/*
      H1 pe două rânduri, cu break forțat. Contrastul dintre cele două
      propoziții E mesajul — pe un singur rând se pierde.
    */}
    <h1>
      {hero.h1.map((rand, i) => (
        <span class:list={['rand', i === 1 && 'accentuat']}>
          {rand}
        </span>
      ))}
    </h1>

    {/*
      Sub titlu, două coloane pe desktop. Înainte, argumentul stătea singur
      pe stânga și jumătatea dreaptă rămânea goală — arăta a pagină
      neterminată, nu a spațiu deliberat. Informația practică umple coloana a
      doua și primește o formă proprie: fișa evenimentului, în limbajul
      documentului de lucru pe care îl promite pagina.
    */}
    <div class="sub">
      <div class="argument">
        <p class="subheadline">{hero.subheadline}</p>
        <p class="pentru-cine">{hero.pentruCine}</p>
        <Cta marime="mare" spatiuSus />
      </div>

      <aside class="fisa">
        <dl>
          <div><dt>Data</dt><dd>{EVENIMENT.dataText}</dd></div>
          <div><dt>Ora</dt><dd>{EVENIMENT.ora}</dd></div>
          <div><dt>Locul</dt><dd>{EVENIMENT.locatie}<span>{EVENIMENT.oras}</span></dd></div>
          <div><dt>Locuri</dt><dd>{EVENIMENT.capacitate}</dd></div>
        </dl>

        <div class="micro-proof">
          {hero.microProof.map((linie) => <p>{linie}</p>)}
        </div>
      </aside>
    </div>
  </div>
</header>

<style>
  .hero {
    /* Fundal curat. Fără imagine generică cu roboți, creiere sau rețele
       neuronale — regula e explicită în documentul sursă. */
    background: var(--bg);
    padding-block: var(--sp-2xl);
    padding-inline: var(--lat);
  }

  .continut {
    max-width: var(--max-continut);
    margin-inline: auto;
    position: relative;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    /* Literă mică deliberat: e numele produsului, dar nu trebuie să concureze
       cu H1-ul. Greutatea vizuală o dă spațierea, nu dimensiunea. */
    text-transform: lowercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--sp-md);
  }

  h1 {
    font-size: var(--t-h1);
    max-width: 18ch;
  }

  .rand {
    display: block;
  }
  .rand.accentuat {
    color: var(--secundar);
  }

  .sub {
    display: grid;
    gap: var(--sp-lg);
    margin-top: var(--sp-md);
  }

  @media (min-width: 56rem) {
    .sub {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: var(--sp-2xl);
      align-items: start;
    }
    h1 {
      max-width: 20ch;
    }
  }

  .subheadline {
    font-size: var(--t-corp-lg);
    max-width: 44ch;
    /* Nu `--lh-lejer` (1.65): la trei rânduri pe mobil, spațierea de proză
       lungă rupe fraza în rânduri independente. Un subtitlu trebuie citit
       ca o singură unitate. */
    line-height: var(--lh-normal);
  }

  .pentru-cine {
    color: var(--text-muted);
    margin-top: var(--sp-sm);
    max-width: 44ch;
    line-height: var(--lh-normal);
  }

  /* ── Fișa evenimentului ─────────────────────────────────────────────── */

  .fisa {
    border: 1px solid rgba(47, 79, 79, 0.2);
    border-radius: var(--radius-lg);
    padding: var(--sp-sm) var(--sp-lg) var(--sp-md);
  }

  .fisa dl {
    margin: 0;
    display: grid;
  }

  .fisa dl > div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--sp-sm);
    align-items: baseline;
    padding-block: var(--sp-xs);
    border-block-end: 1px solid rgba(47, 79, 79, 0.12);
  }

  .fisa dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
  }

  .fisa dd {
    margin: 0;
    font-weight: 600;
    line-height: var(--lh-normal);
    font-size: var(--t-corp);
  }

  .fisa dd span {
    display: block;
    font-weight: 400;
    color: var(--text-muted);
    font-size: var(--t-mic);
  }

  .micro-proof {
    margin-top: var(--sp-md);
    display: grid;
    gap: var(--sp-xs);
    color: var(--text-muted);
    /* Nu text mărunt de subsol: „25 de locuri. Fără laptop, fără cont…" e
       dovadă, și dezamorsează obiecția „îmi trebuie pregătire". */
    font-size: var(--t-mic);
    line-height: var(--lh-normal);
  }
</style>
