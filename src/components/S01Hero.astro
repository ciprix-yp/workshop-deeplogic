---
import { hero } from '../content/copy';
import Cta from './Cta.astro';
---

{/*
  Fișa evenimentului (dată/oră/loc) a fost retrasă de-aici la pivotul de
  structură (2026-09-02) — TrustBar.astro, chiar dedesubt, o acoperă deja.
  Hero rămâne strict: titlu, promisiune, CTA.
*/}
<header class="hero">
  <div class="continut">
    <p class="eyebrow">{hero.eyebrow}</p>

    {/*
      H1 pe două rânduri, cu break forțat. Contrastul dintre cele două
      propoziții E mesajul — pe un singur rând se pierde.
    */}
    <h1>
      {hero.h1.map((rand, i) => (
        <span class:list={['rand', i === 1 && 'accentuat']}>
          {rand}
        </span>
      ))}
    </h1>

    <p class="subheadline">{hero.subheadline}</p>

    <div class="corp">
      {hero.corp.map((p) => <p>{p}</p>)}
    </div>

    <Cta marime="mare" spatiuSus />
  </div>
</header>

<style>
  .hero {
    /* Fundal curat. Fără imagine generică cu roboți, creiere sau rețele
       neuronale — regula e explicită în documentul sursă. */
    background: var(--bg);
    padding-block: var(--sp-2xl);
    padding-inline: var(--lat);
  }

  .continut {
    max-width: var(--max-proza);
    margin-inline: auto;
    position: relative;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    /* Literă mică deliberat: e numele produsului, dar nu trebuie să concureze
       cu H1-ul. Greutatea vizuală o dă spațierea, nu dimensiunea. */
    text-transform: lowercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--sp-md);
  }

  h1 {
    font-size: var(--t-h1);
    max-width: 20ch;
  }

  .rand {
    display: block;
  }
  .rand.accentuat {
    color: var(--secundar);
  }

  .subheadline {
    font-size: var(--t-corp-lg);
    max-width: 44ch;
    margin-top: var(--sp-md);
    line-height: var(--lh-normal);
  }

  .corp {
    margin-top: var(--sp-sm);
    display: grid;
    gap: var(--sp-2xs);
    color: var(--text-muted);
    line-height: var(--lh-normal);
  }
</style>
