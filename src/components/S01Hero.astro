---
import { hero, EVENIMENT } from '../content/copy';
import Cta from './Cta.astro';
import IndicatorScrollIntern from './IndicatorScrollIntern.astro';
---

<header class="hero" data-card data-fundal="primar">
  {/* v5: crom + conținut, doi frați — vezi Sectiune.astro și labirint.css. */}
  <div class="placa larg" data-tilt="card">
    <div class="sticla-chrome" aria-hidden="true" data-chrome></div>
    <div class="continut">
      <p class="eyebrow">{hero.eyebrow}</p>

      {/*
        H1 pe două rânduri, cu break forțat. Contrastul dintre cele două
        propoziții E mesajul — pe un singur rând se pierde.
      */}
      <h1>
        {hero.h1.map((rand, i) => (
          <span class:list={['rand', i === 1 && 'accentuat']}>{rand}</span>
        ))}
      </h1>

      {/*
        Sub titlu, două coloane pe desktop. Înainte, argumentul stătea singur
        pe stânga și jumătatea dreaptă rămânea goală — arăta a pagină
        neterminată, nu a spațiu deliberat. Informația practică umple coloana a
        doua și primește o formă proprie: fișa evenimentului, în limbajul
        documentului de lucru pe care îl promite pagina.
      */}
      <div class="sub">
        <div class="argument">
          <p class="subheadline">{hero.subheadline}</p>
          <p class="pentru-cine">{hero.pentruCine}</p>
          <Cta marime="mare" spatiuSus />
        </div>

        <aside class="fisa">
          <dl>
            <div><dt>Data</dt><dd>{EVENIMENT.dataText}</dd></div>
            <div><dt>Ora</dt><dd>{EVENIMENT.ora}</dd></div>
            <div><dt>Locul</dt><dd>{EVENIMENT.locatie}<span>{EVENIMENT.oras}</span></dd></div>
            <div><dt>Locuri</dt><dd>{EVENIMENT.capacitate}</dd></div>
          </dl>

          <div class="micro-proof">
            {hero.microProof.map((linie) => <p>{linie}</p>)}
          </div>
        </aside>
      </div>
    </div>
  </div>
  <IndicatorScrollIntern fundal="primar" />
</header>

<style>
  /* Hero = cardul #1 al secvenței, aceeași regulă „card" din Sectiune.astro
     (§16-DESIGN_BRIEF, „Layout"), scrisă direct aici pentru că hero nu
     trece prin componenta Sectiune. `safe center` — același fix QA #1 din
     Sectiune.astro, motivat acolo pe larg: fără `safe`, un hero cu overflow
     real (măsurat 118px la 360×800) își împinge h1-ul deasupra ariei
     vizibile, inaccesibil prin scroll. */
  .hero {
    /* Fundal curat. Fără imagine generică cu roboți, creiere sau rețele
       neuronale — regula e explicită în documentul sursă. */
    background: var(--bg);
    /* v3/v4: registrul curent — citit de tenta plăcii de sticlă (tokens.css).
       Vezi comentariul identic din Sectiune.astro. */
    --bg-registru: var(--bg);
    --sticla-alpha: 82%;

    height: 100dvh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    overflow-y: auto;
    /* v5: `position: relative` da, `z-index: 0` NU — vezi comentariul lung
       din Sectiune.astro (`.sectiune.card`): un context de stacking pe card
       ar fi ținut placa sub stratul fix al labirintului. */
    position: relative;
    /* FĂRĂ overscroll-behavior-y: contain — vezi comentariul din
       Sectiune.astro: blochează scroll-chaining-ul nativ spre document. */
    scrollbar-gutter: stable;
    box-sizing: border-box;

    /* v5: padding-ul cardului E banda de labirint — vezi Sectiune.astro. */
    padding-top: calc(var(--banda-sus) + env(safe-area-inset-top, 0px));
    padding-inline: calc(var(--marja-sticla) + env(safe-area-inset-left, 0px))
      calc(var(--marja-sticla) + env(safe-area-inset-right, 0px));
    padding-bottom: calc(var(--banda-jos) + env(safe-area-inset-bottom, 0px) + 4rem);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-bottom: calc(var(--banda-sus) + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (max-height: 559.98px) {
    .hero {
      justify-content: flex-start;
    }
  }

  /* Compensarea padding-ului plăcii — vezi Sectiune.astro: măsura de text
     rămâne identică, doar placa e mai lată cu exact padding-ul ei. */
  .placa.larg {
    max-width: calc(var(--max-continut) + 2 * var(--pad-sticla));
  }
  .continut {
    max-width: var(--max-continut);
    margin-inline: auto;
    position: relative;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    /* Literă mică deliberat: e numele produsului, dar nu trebuie să concureze
       cu H1-ul. Greutatea vizuală o dă spațierea, nu dimensiunea. */
    text-transform: lowercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--sp-md);
  }

  h1 {
    font-size: var(--t-h1);
    max-width: 18ch;
  }

  .rand {
    display: block;
  }
  .rand.accentuat {
    color: var(--secundar);
  }

  .sub {
    display: grid;
    gap: var(--sp-xl);
    margin-top: var(--sp-lg);
  }

  @media (min-width: 56rem) {
    .sub {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: var(--sp-2xl);
      align-items: start;
    }
    h1 {
      max-width: 20ch;
    }
  }

  .subheadline {
    font-size: var(--t-corp-lg);
    max-width: 44ch;
    /* Nu `--lh-lejer` (1.65): la trei rânduri pe mobil, spațierea de proză
       lungă rupe fraza în rânduri independente. Un subtitlu trebuie citit
       ca o singură unitate. */
    line-height: var(--lh-normal);
  }

  .pentru-cine {
    color: var(--text-muted);
    margin-top: var(--sp-sm);
    max-width: 44ch;
    line-height: var(--lh-normal);
  }

  /* ── Fișa evenimentului ─────────────────────────────────────────────── */

  .fisa {
    border: 1px solid rgba(47, 79, 79, 0.2);
    border-radius: var(--radius-lg);
    padding: var(--sp-md) var(--sp-lg) var(--sp-lg);
  }

  .fisa dl {
    margin: 0;
    display: grid;
  }

  .fisa dl > div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--sp-sm);
    align-items: baseline;
    padding-block: var(--sp-sm);
    border-block-end: 1px solid rgba(47, 79, 79, 0.12);
  }

  .fisa dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted);
  }

  .fisa dd {
    margin: 0;
    font-weight: 600;
    line-height: var(--lh-normal);
    font-size: var(--t-corp);
  }

  .fisa dd span {
    display: block;
    font-weight: 400;
    color: var(--text-muted);
    font-size: var(--t-mic);
  }

  .micro-proof {
    margin-top: var(--sp-md);
    display: grid;
    gap: var(--sp-xs);
    color: var(--text-muted);
    /* Nu text mărunt de subsol: „25 de locuri. Fără laptop, fără cont…" e
       dovadă, și dezamorsează obiecția „îmi trebuie pregătire". */
    font-size: var(--t-mic);
    line-height: var(--lh-normal);
  }
</style>
