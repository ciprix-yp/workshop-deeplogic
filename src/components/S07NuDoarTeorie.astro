---
import { nuDoarTeorie } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

<Sectiune id="nu-doar-teorie" camp="zgomot">
  <h2>{nuDoarTeorie.h2}</h2>
  <ul>
    {nuDoarTeorie.lista.map((l, i) => <li data-reveal style={`--intarziere: ${i * 60}ms`}>{l}</li>)}
  </ul>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-lg);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-md);
  }

  li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    align-items: baseline;
    font-size: var(--t-corp-lg);
  }

  li::before {
    content: '—';
    color: var(--accent-decor);
    font-weight: 600;
  }
</style>
