---
import { agravare } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

{/*
  Secțiune nouă (pivot de structură 2026-09-02) — costul tăcut al unui
  început fără o problemă clară.

  Text nou (2026-09-07, a patra rundă): secțiunea s-a strâns de la trei
  blocuri de proză + un card bogat la titlu → UN paragraf → card. Cardul
  („quickwin", numit așa de Ciprian) rămâne pe `.card-depth`, aceeași sticlă
  mată ca biletul din Trust bar — nu un al doilea tratament de card pe
  pagină. E singura întoarcere pozitivă din secțiune, după acumularea din
  paragraful de deasupra.
*/}
<Sectiune id="agravare">
  <h2 data-reveal>{agravare.h2}</h2>

  <div class="corp">
    {agravare.corp.map((p) => (
      <p data-reveal>{p}</p>
    ))}
  </div>

  <div class="merita card-depth" data-reveal>
    <h3>{agravare.card.h3}</h3>
    {agravare.card.linii.map((p) => (
      <p>{p}</p>
    ))}
  </div>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-h2);
    max-width: 20ch;
    margin-bottom: var(--sp-md);
  }

  .corp {
    display: grid;
    gap: var(--sp-xs);
    max-width: var(--max-proza);
    font-size: var(--t-corp-lg);
    line-height: var(--lh-normal);
  }

  .merita {
    margin-top: var(--sp-xl);
    padding: var(--sp-lg);
    display: grid;
    gap: var(--sp-xs);
  }

  .merita h3 {
    font-family: var(--font-titlu);
    font-weight: 700;
    font-size: var(--t-h3);
    margin-bottom: var(--sp-2xs);
  }

  /* Cele două rânduri, aceeași greutate: perechea „nu X / ci Y" își face
     singură contrastul din cuvinte, n-are nevoie și de unul tipografic. */
  .merita p {
    line-height: var(--lh-normal);
    color: var(--secundar);
  }
</style>
