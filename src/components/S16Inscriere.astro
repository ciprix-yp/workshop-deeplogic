---
import { ctaFinal } from '../content/copy';
import Sectiune from './Sectiune.astro';
import Cta from './Cta.astro';

/**
 * Închiderea paginii — al treilea și ultimul repetaj de CTA (după hero și
 * finalul lui Rezultatul — pivot de structură 2026-09-02, doar trei repetaje
 * pe o pagină de zece secțiuni, în loc de patru pe șaisprezece). Formularul
 * propriu-zis nu mai trăiește în flux — a fost mutat în DialogInscriere.astro
 * (dialog modal, deschis de orice CTA de pe pagină). Copy-ul de-aici
 * (`ctaFinal`) NU mai e cel din antetul dialogului — dialogul are propriul
 * export (`inscriere`, § procedural: „Înscrierea durează câteva minute...")
 * — vezi DialogInscriere.astro. `ctaFinal` rămâne doar aici, ca închidere
 * finală a paginii, motivațională, nu procedurală.
 *
 * `id="inscriere-cta"` — CtaFloating.astro observă exact acest id ca să
 * ascundă butonul flotant când secțiunea asta intră în ecran.
 */
---

<Sectiune id="inscriere-cta">
  <div class="antet">
    <h2 data-reveal>
      {ctaFinal.h2.map((rand) => <span class="rand">{rand}</span>)}
    </h2>
    <p class="meta" data-reveal>{ctaFinal.meta}</p>
    <div class="corp">
      {ctaFinal.corp.map((p) => <p data-reveal>{p}</p>)}
    </div>
    <p class="accent" data-reveal>{ctaFinal.accent}</p>
    <Cta marime="mare" spatiuSus />
  </div>
</Sectiune>

<style>
  .antet {
    max-width: var(--max-proza);
  }

  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  .rand {
    display: block;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--t-mic);
    color: var(--secundar);
    margin-bottom: var(--sp-lg);
  }

  .corp {
    display: grid;
    gap: var(--sp-2xs);
    font-size: var(--t-corp-lg);
    color: var(--text-muted);
  }

  .accent {
    margin-top: var(--sp-sm);
    margin-bottom: var(--sp-lg);
    font-weight: 700;
    font-size: var(--t-corp-lg);
    color: var(--accent);
  }
</style>
