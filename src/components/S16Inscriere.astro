---
import { ctaFinal } from '../content/copy';
import Sectiune from './Sectiune.astro';
import Cta from './Cta.astro';

/**
 * Închiderea paginii — al patrulea CTA (regulă CLAUDE.md: hero, după §05,
 * după §08, aici). Formularul propriu-zis nu mai trăiește în flux — a fost
 * mutat în DialogInscriere.astro (dialog modal, deschis de orice CTA de pe
 * pagină). [corectat — audit impeccable, 2026-09-01] Copy-ul de-aici
 * (`ctaFinal`) NU mai e cel din antetul dialogului — de la pivotul PRIMUL
 * PAS, dialogul are propriul export (`inscriere`, § procedural: „Înscrierea
 * durează câteva minute...") — vezi DialogInscriere.astro. `ctaFinal` rămâne
 * doar aici, ca închidere finală a paginii, motivațional, nu procedural.
 */
---

<Sectiune id="inscriere-cta">
  <div class="antet">
    <h2>{ctaFinal.h2}</h2>
    <p class="corp">{ctaFinal.corp}</p>
    <p class="meta">{ctaFinal.meta}</p>
    <Cta marime="mare" spatiuSus />
  </div>
</Sectiune>

<style>
  .antet {
    max-width: var(--max-proza);
  }

  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  .corp {
    font-size: var(--t-corp-lg);
  }

  .meta {
    font-family: var(--font-mono);
    color: var(--secundar);
    margin-top: var(--sp-md);
  }
</style>
