---
import { useCases } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

<Sectiune id="use-cases" latime="larg">
  <h2>{useCases.h2}</h2>

  {/*
    Prima linie de corp e OBLIGATORIE. Fără ea, secțiunea promite cinci domenii
    acoperite în trei ore — și pagina minte.
  */}
  <p class="disclaimer">{useCases.disclaimer}</p>

  <div class="grila">
    {useCases.grid.map((z, i) => (
      // Doi „purtători" de transform separați, deliberat: `.zona` intră în
      // cadru cu perspectiva de la scroll (560ms, data-reveal); `.zona-tilt`
      // urmărește cursorul (150ms, data-tilt). Pe același element, cele două
      // tranziții s-ar bate pe aceeași proprietate `transform` — cea mai
      // specifică regulă CSS ar câștiga ÎNTREG lanțul, iar tilt-ul ar deveni
      // la fel de lent ca intrarea. Separate, nu se ating niciodată.
      <article class="zona" data-reveal style={`--intarziere: ${i * 70}ms`}>
        <div class="zona-tilt" data-tilt>
          <h3>{z.titlu}</h3>
          <p>{z.corp}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="incheiere">
    {useCases.incheiere.map((p) => <p>{p}</p>)}
  </div>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  .disclaimer {
    color: var(--text-muted);
    max-width: var(--max-proza);
    margin-bottom: var(--sp-lg);
  }

  .grila {
    display: grid;
    gap: var(--sp-md);
  }

  @media (min-width: 40rem) {
    .grila {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .grila {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* `.zona` (data-reveal) rămâne fără transform propriu în stare de repaus —
     doar container de layout pentru grid. Tot ce se vede ca „obiect" (bordură,
     umbră, tilt) trăiește pe `.zona-tilt` (data-tilt), din motivul explicat
     lângă markup. */
  .zona {
    display: grid;
  }

  .zona-tilt {
    padding: var(--sp-md);
    border: 1px solid rgba(47, 79, 79, 0.15);
    border-radius: var(--radius-lg);
    background: var(--bg);
    /* v3: registru local pentru scrim-ul Câmpului — defensiv, vezi
       S02Problema.astro. */
    --bg-registru: var(--bg);
    display: grid;
    gap: var(--sp-2xs);
    align-content: start;
    height: 100%;
    box-sizing: border-box;
  }

  h3 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent);
  }

  .zona p {
    font-size: var(--t-corp);
    line-height: var(--lh-normal);
  }

  .incheiere {
    margin-top: var(--sp-lg);
    max-width: var(--max-proza);
    display: grid;
    gap: var(--sp-xs);
    color: var(--secundar);
  }
</style>
