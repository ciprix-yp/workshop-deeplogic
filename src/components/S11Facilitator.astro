---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { facilitator } from '../content/copy';
import Sectiune from './Sectiune.astro';

/**
 * Verificăm la build, ca să nu randăm un `<img>` care ar afișa iconița de
 * imagine ruptă dacă fișierul chiar lipsește — pe o pagină a cărei miză
 * declarată e credibilitatea, un asset stricat costă mai mult decât absența
 * lui. Când fișierul apare în public/, secțiunea îl preia automat, fără
 * altă modificare de cod.
 *
 * Fix (2026-09-02): calea relativă la `import.meta.url` funcționa în `astro
 * dev` (rulează direct din sursă), dar `existsSync` întorcea `false` tăcut
 * la build de producție — Vite mută componenta în bundle-ul de server,
 * unde `import.meta.url` nu mai pointează spre `src/components/`, deci
 * `../../public/...` calculat de-acolo nu mai există. `process.cwd()` e
 * stabil în ambele cazuri: rădăcina proiectului de unde rulează `astro
 * build`/`astro dev`, indiferent unde ajunge fișierul componentei în bundle.
 */
const caleFoto = join(process.cwd(), 'public', facilitator.foto.src);
const areFoto = existsSync(caleFoto);
---

{/*
  Layout schimbat (2026-09-02, a treia rundă): fostul aranjament „poză mare
  în stânga, text în dreapta" înlocuit cu un byline compact — nume + rol în
  stânga, poză rotundă, medie, în dreapta — urmat de bio pe toată lățimea
  dedesubt. Cerut explicit.
*/}
<Sectiune id="facilitator" latime="larg">
  <h2 data-reveal>{facilitator.h2}</h2>

  <div class="byline" data-reveal>
    <div class="identitate">
      <p class="nume">{facilitator.nume}</p>
      <p class="rol">{facilitator.rol}</p>
    </div>

    {areFoto && (
      <img
        class="foto"
        src={facilitator.foto.src}
        alt={facilitator.foto.alt}
        width="168"
        height="168"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  <div class="corp">
    {facilitator.corp.map((p) => <p data-reveal>{p}</p>)}
  </div>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  .byline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-lg);
    padding-bottom: var(--sp-lg);
    margin-bottom: var(--sp-lg);
    border-bottom: 1px solid rgba(47, 79, 79, 0.15);
  }

  .identitate {
    display: grid;
    gap: var(--sp-2xs);
  }

  .nume {
    font-family: var(--font-titlu);
    font-size: var(--t-h3);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .rol {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  /* Cadru rotund — 10.5rem, cu 50% mai mare decât 7rem (cerut explicit,
     2026-09-02, a patra rundă). */
  .foto {
    flex: none;
    width: 10.5rem;
    height: 10.5rem;
    border-radius: 50%;
    object-fit: cover;
    /* Fotografie reală, la lucru sau la un eveniment — nu portret corporate pe
       fundal alb, nu stock. Regula e în documentul sursă. */
    box-shadow: var(--shadow-card);
    border: 3px solid var(--bg);
  }

  .corp {
    display: grid;
    gap: var(--sp-sm);
    max-width: var(--max-proza);
  }

  @media (max-width: 30rem) {
    .byline {
      gap: var(--sp-md);
    }
    .foto {
      /* Aceeași proporție +50% ca varianta desktop (5.5rem → 8.25rem). */
      width: 8.25rem;
      height: 8.25rem;
    }
  }
</style>
