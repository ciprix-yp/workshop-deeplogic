---
import { CTA } from '../content/copy';
---

{/*
  Buton CTA flotant — cerut explicit (2026-09-02), înlocuiește fosta bară
  fixă doar-pe-mobil (CtaSticky.astro). Vizibil pe toate viewport-urile,
  nu doar mobil.

  Se ascunde ori de câte ori ORICE alt CTA de pe pagină (hero, finalul lui
  Rezultatul, CTA final) e deja pe ecran — nu doar la CTA-ul final. Fix
  (2026-09-02, feedback „două butoane unul lângă altul"): varianta veche
  observa STRICT hero-ul + `#inscriere-cta`, deci rămânea vizibil suprapus
  peste CTA-ul din mijlocul secțiunii Rezultatul. Acum observă fiecare
  `.cta` din pagină, generic — se ascunde cât timp oricare e vizibil.

  A doua condiție de ascundere (2026-09-07, cerută explicit): butonul dispare
  și când utilizatorul se OPREȘTE din derulat, nu doar când un alt CTA e pe
  ecran — nu are rost să concureze vizual cu conținutul cât timp cineva
  citește static o secțiune. Reapare la primul gest de scroll. Vizibilitatea
  finală e ȘI cele două condiții simultan (nu doar `.cta` suprapus, nu doar
  scroll activ) — vezi `actualizeaza()`.

  E un `<a href="#inscriere">` normal — interceptat de ascultătorul global
  din DialogInscriere.astro (`a[href="#inscriere"]`), la fel ca orice alt
  CTA de pe pagină. Niciun cod separat de deschidere aici.

  Formă schimbată din pastilă-în-colț în bară pe lățime plină, jos (audit de
  design, 2026-09-07): scanare vizuală programatică la 360px a găsit pastila
  (165×72px, colț dreapta-jos) acoperind text îngroșat intenționat, la
  mijloc de propoziție, în ~40% din pozițiile de scroll unde era eligibilă
  să apară (§Agravare, §Facilitator, §FAQ) — rootMargin-ul pozitiv de mai
  jos apără doar de suprapunerea cu alt `.cta`, proza n-a fost niciodată în
  ecuație. O bară pe lățime plină nu reduce ce se acoperă pe orizontală, dar
  mută ocluzia într-o zonă FIXĂ și previzibilă (ultimii ~60px de jos), la
  fel cum BaraScarcity ocupă deja o zonă fixă sus — mai bine decât să taie
  aleator orice paragraf ajunge sub colțul din dreapta la momentul potrivit.
*/}
<a href={CTA.ancora} id="cta-floating" class="floating" hidden aria-label={CTA.text} aria-haspopup="dialog">
  <span class="text">{CTA.text}</span>
  <span class="locuri" data-locuri-cta hidden></span>
</a>

<script>
  (() => {
    const buton = document.getElementById('cta-floating');
    // Toate CTA-urile din flux — hero, finalul lui Rezultatul, CTA final.
    // Butonul flotant lui însuși nu e `.cta`, deci nu se auto-observă.
    const cteuri = Array.from(document.querySelectorAll<HTMLElement>('a.cta'));
    if (!buton || !cteuri.length || !('IntersectionObserver' in window)) return;

    // Set, nu contor incrementat/decrementat: idempotent indiferent de câte
    // ori se raportează același element — un contor simplu a dublat/pierdut
    // tranziții (verificat: butonul rămânea ascuns permanent după primul
    // CTA din flux ieșit din cadru).
    const vizibile = new Set<Element>();

    /*
     * ── Ascundere la inactivitate (2026-09-07, cerut explicit) ─────────────
     * „Dispare când se oprește scroll-ul, la 1 sec. Reapare la scroll, la
     * 0.5sec." Cele două valori sunt DEBOUNCE-uri — cât se așteaptă după
     * evenimentul declanșator — nu durate de animație; tranziția CSS
     * (opacitate/transform, 250ms) rămâne neschimbată.
     *
     * `opritScroll` se resetează la FIECARE eveniment de scroll (debounce
     * clasic „a stat liniștit X ms") — firește 1000ms după ultimul scroll.
     * `pornitScroll` se pornește O SINGURĂ DATĂ per tranziție inactiv→activ,
     * fără reset: dacă l-am reporni la fiecare eveniment (ca pe celălalt),
     * un scroll continuu mai lung de 500ms n-ar mai apuca niciodată să tragă
     * concluzia „chiar se derulează" — reveal-ul ar fi amânat la nesfârșit.
     *
     * Pornește ascuns (`true`): înainte de primul gest de scroll, pagina
     * „stă", exact starea pe care regula o tratează ca inactivitate.
     */
    let opritScroll: ReturnType<typeof setTimeout> | undefined;
    let pornitScroll: ReturnType<typeof setTimeout> | undefined;
    let ascunsInactiv = true;

    const actualizeaza = () => {
      const arata = vizibile.size === 0 && !ascunsInactiv;
      buton.hidden = !arata;
      buton.classList.toggle('vizibil', arata);
    };

    const laScroll = () => {
      clearTimeout(opritScroll);
      opritScroll = setTimeout(() => {
        ascunsInactiv = true;
        actualizeaza();
      }, 1000);

      if (ascunsInactiv && !pornitScroll) {
        pornitScroll = setTimeout(() => {
          ascunsInactiv = false;
          pornitScroll = undefined;
          actualizeaza();
        }, 500);
      }
    };
    // `passive`: nu blochează scroll-ul propriu-zis (nici pe cel cu inerție
    // al Lenis — vezi Base.astro; Lenis mișcă `window.scrollTo()` real în
    // modul implicit, fără wrapper, deci evenimentul nativ tot pornește).
    window.addEventListener('scroll', laScroll, { passive: true });

    const observator = new IntersectionObserver(
      (intrari) => {
        for (const intrare of intrari) {
          if (intrare.isIntersecting) vizibile.add(intrare.target);
          else vizibile.delete(intrare.target);
        }
        actualizeaza();
      },
      /*
       * Fix (a cincea rundă, 2026-09-02 — „butonul flotant se suprapune cu
       * CTA-ul"): un rootMargin NEGATIV (`-25%`, varianta veche) ÎNGUSTEAZĂ
       * regiunea în care un element contează ca „vizibil" — un `.cta` era
       * declarat „vizibil" abia după ce intra ADÂNC în ecran, mult după ce
       * ajunsese deja (la baza fixă a paginii, `bottom: 20px`) exact peste
       * poziția fixă a butonului flotant. Rezultat: suprapunere reală, nu
       * doar o clipă la încărcare. Nevoia e inversă — să dispară DEVREME,
       * cât timp CTA-ul din flux e încă sub fold, nu abia când ajunge sus.
       * Un rootMargin POZITIV lărgește regiunea de detecție DINCOLO de
       * marginea de jos a ecranului: un `.cta` e „vizibil" (deci flotantul
       * se ascunde) cu până la 200px înainte să apară fizic — timp suficient
       * pentru tranziția de 250ms (`.floating`) să se termine cu mult înainte
       * ca cele două să ajungă vreodată să se atingă pe ecran.
       */
      { threshold: 0, rootMargin: '0px 0px 200px 0px' },
    );
    cteuri.forEach((el) => observator.observe(el));

    // La încărcare, primul callback async al observer-ului încă n-a rulat —
    // fără asta, butonul ar apărea o clipă (Set gol) înainte ca hero-ul
    // să fie raportat ca vizibil.
    actualizeaza();
  })();
</script>

<style>
  .floating {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-sm);
    padding: 14px var(--lat);
    padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    /*
     * Sticlă mată — cerută explicit (2026-09-02): lime translucid + blur,
     * nu opac plat. Opacitate ținută sus (0.88) deliberat: contrastul de
     * 8.01:1 verificat pentru --pe-lime pe lime OPAC nu se garantează
     * automat pe un fundal translucid — la opacitate mare, orice s-ar vedea
     * prin spate rămâne un ecart mic față de lime pur, deci marja se
     * păstrează practic neschimbată; blur-ul dă senzația de sticlă fără
     * să sacrifice lizibilitatea.
     */
    background: rgba(132, 204, 22, 0.88);
    backdrop-filter: blur(20px) saturate(1.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--pe-lime);
    text-decoration: none;
    font-family: var(--font-titlu);
    box-shadow: 0 -10px 26px -6px rgba(132, 204, 22, 0.5), 0 -2px 6px rgba(42, 52, 57, 0.16);
    opacity: 0;
    transform: translateY(100%);
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out),
      background-color 0.15s ease;
  }

  .floating.vizibil {
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .floating:hover {
      background: rgba(107, 168, 18, 0.9);
    }
  }

  .floating:focus-visible {
    background: rgba(107, 168, 18, 0.9);
  }

  .floating:active {
    transform: scale(0.99);
  }

  .text {
    font-weight: 600;
    font-size: var(--t-corp);
  }

  .locuri {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    opacity: 0.85;
  }

  /* Fallback fără backdrop-filter (Firefox < 103, WebView Android vechi) —
     opacitate mai mare, ca sticla să nu devină ilizibilă fără blur. */
  @supports not (backdrop-filter: blur(1px)) {
    .floating {
      background: rgb(132, 204, 22);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating {
      transition-duration: 0.01ms;
    }
  }
</style>
