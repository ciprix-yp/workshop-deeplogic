---
/**
 * Controllerul de carduri — fostul `RailFir.astro`.
 *
 * ── Ce s-a întâmplat cu Firul (v5) ────────────────────────────────────────
 *
 * Widget-ul `<nav class="rail-fir">` a fost ȘTERS; controller-ul de mai jos
 * a supraviețuit intact. Nu e o ștergere, e o absorbție: railul spunea „ești
 * la cardul k din 16, iar 4 dintre ele sunt CTA-uri", iar coridorul din
 * `Labirint.astro` spune exact asta — 16 rânduri, 4 checkpointuri marcate
 * `--accent`. Justificarea din v4 („trei scări diferite, nu concurează")
 * funcționa cât timp fundalul purta ZERO informație; labirintul poartă, deci
 * justificarea a expirat. Coridorul spune, în plus, și FORMA a ce urmează:
 * dens și ramificat sus, deschis și drept jos.
 *
 * Costul pe accesibilitate e zero: railul era `aria-hidden="true"` +
 * `pointer-events: none`, deci nu contribuia nimic pentru cititoarele de
 * ecran. Numele fișierului s-a schimbat pentru că „RailFir" devenise o
 * minciună — conținutul lui a fost dintotdeauna controller-ul.
 *
 * ── Cele trei responsabilități, toate pe un singur senzor ─────────────────
 *
 *  1. Navigarea pe carduri (Lenis, snap pe viteză, ancore, tastatură) — v4,
 *     neschimbată.
 *  2. `.camp-activ` (cardul activ + vecinii imediați, max 3 din 16). În v5 are
 *     un singur consumator rămas: `backdrop-filter`-ul plăcii pe registrul
 *     ÎNCHIS. Deriva Câmpului a dispărut odată cu Câmpul, iar translucența de
 *     pe registrele deschise a fost tăiată — vezi src/styles/labirint.css.
 *  3. Scrub-ul labirintului — bucla rAF de la finalul fișierului.
 */
---

<script is:inline>
  /*
   * Disclosure de overflow real — INDEPENDENT de reduced-motion, deliberat.
   *
   * Cele două condiții din IndicatorScrollIntern.astro (viewport sub 560px,
   * `.scroll-intern` forțat pe §16) sunt pragurile proiectate explicit în
   * brief, verificabile fără JS. În practică, tipografia fluidă existentă
   * (calibrată pentru fluxul continuu v1) nu garantează fit perfect pe
   * fiecare card la orice combinație de conținut — verificat direct, nu
   * presupus: la 360×800 (breakpoint-ul de referință din CLAUDE.md §2),
   * majoritatea cardurilor depășesc 100dvh cu mult mai mult decât acoperă
   * cele două praguri de mai sus (vezi IMPLEMENTATION_NOTES.md). Fără script
   * era, cardurile devin totuși derulabile (overflow-y:auto e mereu activ),
   * dar utilizatorul n-ar vedea NICIUN semnal că mai e conținut — exact
   * genul de „taiere tăcută" pe care regula din CLAUDE.md §2 o interzice.
   *
   * Nu e „mișcare" — e o măsurătoare + un toggle de vizibilitate, deci
   * rulează necondiționat de `prefers-reduced-motion`. Cele două condiții
   * pur-CSS rămân valabile ca prag de bază, fără JS.
   *
   * Fix QA #4 (iterația 2): indicatorul rămânea vizibil chiar și după ce
   * cardul era derulat complet până la capăt — clasele erau calculate o
   * singură dată din geometrie statică (load/resize/fonts.ready), nu se
   * actualizau la `scroll`. `.scroll-vazut-complet` (togglat pe fiecare
   * eveniment `scroll` al cardului, prag `scrollTop >= scrollHeight -
   * clientHeight - 1`) ascunde indicatorul exact când semnalul „mai e
   * conținut" ar deveni fals. Tot disclosure, nu mișcare — rulează la fel,
   * necondiționat de `prefers-reduced-motion`.
   */
  (() => {
    const carduri = document.querySelectorAll('[data-card]');
    if (carduri.length === 0) return;

    function scrollComplet(c) {
      return c.scrollHeight - c.clientHeight - c.scrollTop <= 1;
    }

    function verificaOverflow() {
      carduri.forEach((c) => {
        c.classList.toggle('deruleaza-real', c.scrollHeight - c.clientHeight > 1);
        c.classList.toggle('scroll-vazut-complet', scrollComplet(c));
      });
    }
    verificaOverflow();

    carduri.forEach((c) => {
      c.addEventListener('scroll', () => c.classList.toggle('scroll-vazut-complet', scrollComplet(c)), {
        passive: true,
      });
    });

    let recalcTimer;
    window.addEventListener('resize', () => {
      clearTimeout(recalcTimer);
      recalcTimer = setTimeout(verificaOverflow, 150);
    });
    window.addEventListener('load', verificaOverflow);
    // Fonturile self-hostate pot sosi puțin după primul calcul de layout —
    // recalculăm o dată în plus la `fonts.ready`, ca un card care abia
    // atunci trece pragul de overflow să nu rateze indicatorul.
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(verificaOverflow);
  })();
</script>

{/*
  Controller unic de navigare pe carduri — v4, pe Lenis.

  NU e `is:inline`, spre deosebire de scriptul de disclosure de mai sus:
  importă `lenis` din node_modules, deci trece prin bundler-ul Astro
  (`type="module"`, deferat). Efect secundar util: rulează garantat după ce
  DOM-ul e parsat, ceea ce elimină din start clasa de bug care a costat
  iterația 1 (scriptul rula înaintea `[data-card]`-urilor și prindea o listă
  goală — vezi IMPLEMENTATION_NOTES.md).
*/}
<script>
  import Lenis from 'lenis';

  /*
   * ── De ce Lenis, după ce brief-ul l-a respins de două ori ────────────────
   *
   * v1 și v2 au recomandat ÎMPOTRIVA lui, cu rezerva scrisă explicit:
   * „acceptabil dacă dovada empirică o cere". Dovada a venit — Ciprian a
   * testat pe telefonul real și a cerut scroll INTERPOLAT la gest lent, nu
   * nativ. Argumentul principal de atunci („majoritatea gesturilor trebuie să
   * rămână 100% native, deci a virtualiza tot scroll-ul e disproporționat")
   * n-a fost combătut, i-a căzut premisa. Al doilea argument — un senzor de
   * viteză fiabil pe trackpad Precision vs. rotiță clasică vs. inerție iOS —
   * era o slăbiciune pe care brief-ul v2 și-o recunoștea singur;
   * `lenis.velocity` o rezolvă cu un semnal normalizat, calculat identic
   * indiferent de sursa gestului.
   *
   * ── Ce a DISPĂRUT, nu s-a adăugat ───────────────────────────────────────
   *
   * Lenis nu e un al patrulea sistem peste cele trei existente; le înlocuiește:
   *   · acumulatorul de `deltaY` pe fereastră de 100ms (wheel)   → `lenis.velocity`
   *   · istoricul de 6 puncte `touchmove` + viteza la `touchend` → `lenis.velocity`
   *   · animația de salt scrisă de mână (rAF + ease-out cubic)   → `lenis.scrollTo`
   *   · `poateAvansa()` (epuizarea scroll-ului intern al cardului) → `allowNestedScroll`
   * Un senzor în loc de două, calibrate separat, pe unități diferite.
   *
   * ── `allowNestedScroll: true` e cea mai importantă opțiune de aici ──────
   *
   * 12 din 16 carduri au scroll intern real la 360×800 (fallback-ul de
   * aspect ratio, v2). Un Lenis „normal" ar fi capturat gestul la nivel de
   * window și ar fi făcut conținutul acelor carduri de negăsit — exact
   * „tăierea tăcută" pe care CLAUDE.md §2 o interzice pentru §02/§08.
   * `allowNestedScroll` reimplementează nativ regula lui `poateAvansa`: cât
   * timp cardul de sub deget mai are scroll intern ÎN DIRECȚIA gestului,
   * Lenis nu atinge evenimentul (scroll nativ, neîntrerupt); în clipa în
   * care s-a epuizat, preia el. Verificat în sursa Lenis (`hasNestedScroll`),
   * nu presupus din documentație.
   *
   * ── `syncTouch: false` (implicit), deliberat păstrat ────────────────────
   *
   * Pe touch, scroll-ul rămâne NATIV — cu inerția proprie a sistemului, care
   * pe iOS/Android e deja exact „mișcarea super fluidă" cerută, și fără
   * riscul cunoscut de jitter al touch-ului virtualizat. Lenis continuă
   * totuși să calculeze `velocity` din evenimentele native de scroll
   * (`onNativeScroll`), deci senzorul de viteză funcționează identic pe
   * telefon și pe desktop. Interpolarea Lenis se aplică unde chiar lipsea:
   * pe rotiță/trackpad, unde scroll-ul nativ e discret și sacadat.
   */
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
    if (cards.length === 0) return;

    /* ── Labirint: elementele și datele generate la build ─────────────────
       Payload-ul e un `<script type="application/json">` emis de
       Labirint.astro. Generatorul rămâne integral la build — în bundle-ul de
       client ajung doar 240×2 numere și 16 perechi de coordonate. */
    const stratLabirint = document.querySelector<HTMLElement>('[data-labirint]');
    const banda = document.querySelector<HTMLElement>('[data-banda]');
    const subiecte = Array.from(document.querySelectorAll<HTMLElement>('[data-subiect]'));
    const checkpointuri = Array.from(document.querySelectorAll<HTMLElement>('[data-checkpoint]'));
    const cromuri = cards.map((c) => c.querySelector<HTMLElement>('[data-chrome]'));

    let lut: number[] = [];
    let cpProcente: number[][] = [];
    let cursa = 0;
    try {
      const brut = document.querySelector('[data-labirint-date]')?.textContent;
      if (brut) {
        const d = JSON.parse(brut) as { lut?: number[]; cp?: number[][]; cursa?: number };
        lut = Array.isArray(d.lut) ? d.lut : [];
        cpProcente = Array.isArray(d.cp) ? d.cp : [];
        cursa = typeof d.cursa === 'number' ? d.cursa : 0;
      }
    } catch {
      /* Payload corupt = banda rămâne la poziția de start și subiectul nu se
         mișcă. Labirintul, checkpointurile și tot conținutul rămân randate —
         nimic din pagină nu depinde de asta. */
    }

    /* `--org-x` per card: coloana checkpointului lui. Scris O DATĂ, la init —
       e o constantă per card, nu o valoare de cadru.

       Aici e diferența dintre „16 intrări identice" (anti-pattern-ul explicit
       din craft-floor.md) și 16 intrări diferite: direcția din care crește
       placa e coloana reală a checkpointului k, alta la fiecare card.
       Variația vine din geometrie, nu dintr-un `Math.random()` pe origine —
       care ar fi fost fix anti-pattern-ul.

       `--org-y` NU se scrie: în modelul de bandă derulantă, checkpointul e la
       aceeași înălțime pe ecran la fiecare oprire (9.4%, în banda de sus), iar
       aia e o valoare unică pentru toate cele 16. Rămâne cea din CSS. */
    cromuri.forEach((el, i) => {
      const p = cpProcente[i];
      if (!el || !p || p[0] === undefined) return;
      el.style.setProperty('--org-x', `${p[0]}%`);
    });

    const usor = (t: number) => 1 - Math.pow(1 - t, 3); // ease-out cubic

    const lenis = new Lenis({
      // 0.1 = interpolare vizibil „grea", pe măsura plăcilor de sticlă.
      lerp: 0.1,
      smoothWheel: true,
      syncTouch: false,
      allowNestedScroll: true,
      // Ancorele le rutăm manual, mai jos — `anchors: true` NU face
      // `preventDefault()` pe click, deci saltul nativ al browserului ar
      // rula în paralel cu cel interpolat. Verificat în sursă (`onClick`).
      anchors: false,
      autoRaf: true,
    });

    /* ── Poziții absolute ale cardurilor, imune la transform ──────────────
       `data-tilt` scrie pe `transform` (proprietate vizuală) al PLĂCII;
       `offsetTop` e o proprietate de layout, neafectată de transform. */
    function pozitieAbsoluta(el: HTMLElement) {
      let y = 0;
      let n: HTMLElement | null = el;
      while (n) {
        y += n.offsetTop;
        n = n.offsetParent as HTMLElement | null;
      }
      return y;
    }

    let offsets: number[] = [];
    /* Dimensiunile BENZII, măsurate O DATĂ per resize. Banda e plafonată la
       90rem lățime și are ~6.75 ecrane înălțime, deci nu coincide nici cu
       viewport-ul, nici cu documentul — procentele din LUT sunt procente din
       ea. `getBoundingClientRect` apare exact aici și nicăieri altundeva: zero
       citiri de layout în calea de scroll (brief §10.1). */
    let latBanda = 0;
    let inaltBanda = 0;
    let inaltViewport = 0;

    function recalculeazaOffsets() {
      offsets = cards.map(pozitieAbsoluta);
      inaltViewport = document.documentElement.clientHeight || window.innerHeight;
      if (banda) {
        const r = banda.getBoundingClientRect();
        latBanda = r.width;
        inaltBanda = r.height;
      }
    }
    recalculeazaOffsets();

    let recalcTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(recalcTimer);
      recalcTimer = setTimeout(() => {
        recalculeazaOffsets();
        porneste();
      }, 150);
    });
    window.addEventListener('load', () => {
      recalculeazaOffsets();
      porneste();
    });

    /* Notă de tipuri (v4, fix la finalul iterației 4): `offsets` e `number[]`,
       iar proiectul rulează cu `noUncheckedIndexedAccess` — deci `offsets[i]`
       e `number | undefined`, corect: TypeScript nu poate ști că array-ul e
       plin, și chiar EXISTĂ o fereastră reală în care nu e (un `resize` care
       s-a declanșat în timp ce recalcularea e debounce-ată la 150ms, sau un
       apel venit înainte de primul `recalculeazaOffsets`). Peste tot mai jos
       cazul e tratat, nu suprimat cu `!`: iterare cu callback (parametrul e
       `number` prin construcție) sau guard explicit + bail-out. */
    function indexCurent() {
      const y = window.scrollY;
      let cel = 0;
      let distMin = Infinity;
      offsets.forEach((off, i) => {
        const d = Math.abs(off - y);
        if (d < distMin) {
          distMin = d;
          cel = i;
        }
      });
      return cel;
    }

    /* ── Starea per card: o singură sursă de adevăr ───────────────────────
       `.camp-activ` = cardul activ + vecinii imediați, max 3 din 16. E
       plafonul de cost al lui `backdrop-filter` (acum doar pe registrul
       închis) și rămâne comutat de aici, nu de un al doilea observator.

       Registrul labirintului se schimbă TOT de aici, la schimbarea cardului
       dominant. Un strat `position: fixed` nu poate ști pe ce fundal stă, iar
       cardul dominant e prin definiție cel a cărui graniță tocmai a trecut de
       mijlocul ecranului — adică singurul prag corect pentru o comutare
       unică. În timpul tranziției, jumătate din ecran are momentan culoarea
       „greșită" a labirintului; ambele variante greșite sunt mai SLABE, nu mai
       tari, deci degradarea se citește ca o estompare, nu ca un defect.
       O mască scrubată ar fi fost exactă, dar ar fi cerut repictarea
       stratului la fiecare cadru — exact clasa de operație pe care bugetul de
       performanță o interzice. */
    let ultimulIndex = -1;
    function actualizeazaCarduri(index: number, forteaza = false) {
      if (index === ultimulIndex && !forteaza) return;
      ultimulIndex = index;

      cards.forEach((c, i) => {
        c.classList.toggle('camp-activ', Math.abs(i - index) <= 1);
      });

      const registru = cards[index]?.dataset.fundal ?? 'primar';
      if (stratLabirint) stratLabirint.dataset.registru = registru;

      // Checkpointurile vizitate: contur → plin. ≤16 comutări de clasă pe
      // toată pagina, nu 60 pe secundă (vezi de ce „traseul parcurs luminat"
      // prin `stroke-dashoffset` e interzis — brief §10.1).
      checkpointuri.forEach((cp, i) => cp.classList.toggle('vizitat', i <= index));
    }

    /* ── Navigare programată ──────────────────────────────────────────────
       `lock: true`: cât timp saltul rulează, Lenis refuză orice alt scroll
       (verificat în sursă: `if ((isStopped || isLocked) && !force) return`).
       Termenul e ținut de un DEADLINE, nu doar de `onComplete` — dacă
       animația e vreodată înlocuită, `onComplete` nu se mai apelează
       niciodată, iar un flag rămas `true` ar omorî tăcut tot snap-ul. */
    const DURATA_SALT = 0.55; // secunde (unitatea Lenis)
    let animandPanaLa = 0;
    let tintaCurenta: number | null = null;
    let tintaCoada: number | null = null;
    const animand = () => performance.now() < animandPanaLa;

    function navigheazaLa(indexTinta: number) {
      const tinta = Math.min(cards.length - 1, Math.max(0, indexTinta));
      /* Bail-out, nu `!`: dacă lista de offset-uri e goală sau mai scurtă
         decât lista de carduri (fereastra de debounce a lui `resize`),
         `lenis.scrollTo(undefined)` ar produce un salt la NaN — adică
         pagina ar „dispărea". A nu naviga deloc e comportamentul corect;
         următorul gest, după recalculare, ajunge unde trebuie. */
      const yTinta = offsets[tinta];
      if (yTinta === undefined) return;
      if (Math.abs(yTinta - window.scrollY) < 2) return;

      tintaCurenta = tinta;
      animandPanaLa = performance.now() + DURATA_SALT * 1000 + 90;

      lenis.scrollTo(yTinta, {
        duration: DURATA_SALT,
        easing: usor,
        lock: true,
        force: true,
        onComplete: () => {
          animandPanaLa = 0;
          tintaCurenta = null;
          actualizeazaCarduri(indexCurent(), true);
          if (tintaCoada !== null) {
            const urmatoarea = tintaCoada;
            tintaCoada = null;
            navigheazaLa(urmatoarea);
          }
        },
      });
    }

    /* Ținta = prima graniță de card STRICT înaintea poziției curente, în
       direcția gestului. Nu `indexCurent() + directie`: la viteză mare,
       poziția poate fi deja dincolo de mijlocul cardului curent, iar
       „cel mai apropiat + 1" ar sări unul peste. */
    function tintaInDirectia(directie: number) {
      const y = window.scrollY;
      const eps = 4;
      if (directie > 0) {
        // `findIndex` în loc de `for` indexat: parametrul callback-ului e
        // `number` prin construcție, deci dispare și `undefined`-ul, și
        // nevoia de a-l suprima.
        const i = offsets.findIndex((off) => off > y + eps);
        return i === -1 ? offsets.length - 1 : i;
      }
      let ultimul = 0;
      offsets.forEach((off, i) => {
        if (off < y - eps) ultimul = i;
      });
      return ultimul;
    }

    /* ═══ Scrub-ul labirintului ═══════════════════════════════════════════
     *
     * Arhitectura, într-o propoziție: **fiecare valoare animată e o funcție
     * pură a poziției de scroll.** Nu există nicio animație „care rulează",
     * deci nu există nimic de întors și nimic de întrerupt. Asta e tot ce
     * face cerința „înainte ȘI înapoi" — restul e consecință.
     *
     *   pc = 1 − clamp(|offsetCard − scrollY| / vh, 0, 1)
     *
     * `pc` e o DISTANȚĂ, nu o direcție. Aceeași formulă dă aceeași valoare
     * venind de sus sau de jos, deci n-are ce să inverseze. Easing-ul e
     * `smoothstep` (p²(3−2p)) tocmai pentru că e simetric și C¹-continuu:
     * dacă utilizatorul întoarce gestul la jumătatea tranziției, viteza
     * aparentă trece prin zero, nu sare. Un `cubic-bezier` asimetric (ex.
     * curba din tokens.css) ar produce o smucitură vizibilă exact la
     * inversare — de aceea NU se folosește aici.
     *
     * `pc` se calculează întotdeauna din `window.scrollY` (poziția REALĂ), nu
     * din `lenis.targetScroll`: în timpul unui `scrollTo` cu `lock: true`,
     * ținta sare instant la destinație, iar plăcile ar fi sosit înaintea
     * ecranului.
     */
    const LERPURI = [0.18, 0.12, 0.08, 0.05]; // cap → ultima fantomă
    const pozX = new Array<number>(subiecte.length).fill(0);
    const pozY = new Array<number>(subiecte.length).fill(0);
    let asezat = false;
    const cromuriActive = new Set<number>();
    const armat = new Array<boolean>(cards.length).fill(false);
    let licarPanaLa = 0;
    /* `Infinity`, NU `NaN`: cu `NaN`, garda `Math.abs(ty − ultimulTy) > 0.05`
       e falsă la prima trecere (orice comparație cu NaN e falsă), deci camera
       nu se scria niciodată și banda rămânea la origine. Prins pe măsurătoare
       — subiectul ieșea din ecran de la cardul 3 în jos, deși alinierea cu
       checkpointul era perfectă. */
    let ultimulTy = Infinity;

    /** Progresul pe traseu, parametrizat pe CARD (nu pe lungime de arc). */
    function progresTraseu(y: number): number {
      const n = offsets.length;
      if (n < 2) return 0;
      const prim = offsets[0];
      const ultim = offsets[n - 1];
      if (prim === undefined || ultim === undefined) return 0;
      if (y <= prim) return 0;
      if (y >= ultim) return 1;
      let i = 0;
      offsets.forEach((off, k) => {
        if (k < n - 1 && off <= y) i = k;
      });
      const a = offsets[i];
      const b = offsets[i + 1];
      if (a === undefined || b === undefined || b <= a) return i / (n - 1);
      return (i + (y - a) / (b - a)) / (n - 1);
    }

    /** Căutare + interpolare liniară în LUT. Aritmetică pură, zero DOM. */
    function punctPeTraseu(u: number): [number, number] | null {
      const n = lut.length / 2;
      if (n < 2) return null;
      const t = Math.max(0, Math.min(1, u)) * (n - 1);
      const i = Math.min(n - 2, Math.floor(t));
      const f = t - i;
      const x0 = lut[i * 2];
      const y0 = lut[i * 2 + 1];
      const x1 = lut[i * 2 + 2];
      const y1 = lut[i * 2 + 3];
      if (x0 === undefined || y0 === undefined || x1 === undefined || y1 === undefined) return null;
      return [((x0 + (x1 - x0) * f) / 100) * latBanda, ((y0 + (y1 - y0) * f) / 100) * inaltBanda];
    }

    function actualizeazaScrub(): boolean {
      const y = window.scrollY;
      const acum = performance.now();
      let inMiscare = false;

      const u = progresTraseu(y);

      /* ── Camera ─────────────────────────────────────────────────────────
         Banda urcă liniar în `u`, iar checkpointurile sunt echidistante în
         coordonatele benzii. Din cele două împreună rezultă proprietatea pe
         care se sprijină tot restul: **poziția pe ecran a checkpointului în
         repaus e aceeași pentru toate cele 16 carduri** — și e în banda de
         sus, deci subiectul e vizibil la fiecare oprire, inclusiv pe cardurile
         din mijloc, unde placa acoperă restul ecranului.

         Prima implementare avea banda statică (harta întreagă pe ecran) și
         picase exact aici: la 390×844 subiectul era în spatele plăcii pe 13
         din 16 carduri. Verificat pe screenshot, nu dedus. */
      /* `transform` DIRECT, nu o proprietate custom. Prima variantă scria
         `--lab-y` pe bandă și era măsurabil mai scumpă: proprietățile custom
         se moștenesc, deci fiecare scriere invalida stilul întregului subarbore
         — SVG-ul plus cele 16 checkpointuri plus cele 4 elemente-subiect.
         Măsurat cu `Performance.getMetrics` la CPU 4×, pe 3s de scroll continuu:
         RecalcStyle 352ms → 108ms. Aceeași regulă pentru care cromul e un
         element-frunză, aplicată acolo unde o ratasem. */
      if (banda) {
        const ty = -u * cursa * inaltBanda;
        if (Math.abs(ty - ultimulTy) > 0.05) {
          ultimulTy = ty;
          banda.style.transform = `translate3d(0, ${ty.toFixed(1)}px, 0)`;
        }
      }

      /* ── Subiectul + coada ──────────────────────────────────────────────
         Fiecare fantomă are propriul lerp. NICIO logică de direcție: un
         offset semnat pe traseu (`p − 0.004·sign(v)`) ar fi făcut coada să
         sară pe partea cealaltă de fiecare dată când viteza trece prin zero,
         adică la fiecare oprire. Lerp-urile diferite produc același efect fără
         să întrebe vreodată încotro mergem. */
      const tinta = punctPeTraseu(u);
      if (tinta) {
        for (let i = 0; i < subiecte.length; i++) {
          const el = subiecte[i];
          if (!el) continue;
          const l = LERPURI[i] ?? 0.1;
          const cx = pozX[i] ?? 0;
          const cy = pozY[i] ?? 0;
          const nx = asezat ? cx + (tinta[0] - cx) * l : tinta[0];
          const ny = asezat ? cy + (tinta[1] - cy) * l : tinta[1];
          pozX[i] = nx;
          pozY[i] = ny;
          if (Math.abs(tinta[0] - nx) > 0.1 || Math.abs(tinta[1] - ny) > 0.1) inMiscare = true;
          el.style.transform = `translate3d(${nx.toFixed(1)}px, ${ny.toFixed(1)}px, 0)`;
        }
        asezat = true;
      }

      /* ── Materializarea plăcilor ────────────────────────────────────────
         Cel mult 3 carduri au `pc > 0` simultan (cardurile au exact 100dvh,
         deci un card la distanță ≥ vh e complet în afara ecranului). */
      const vh = inaltViewport || window.innerHeight;
      for (let i = 0; i < cards.length; i++) {
        const off = offsets[i];
        const el = cromuri[i];
        if (off === undefined || !el) continue;

        const pc = 1 - Math.min(1, Math.abs(off - y) / vh);
        if (pc <= 0) {
          if (cromuriActive.has(i)) {
            el.style.removeProperty('--pc-s');
            el.style.removeProperty('--pc-o');
            el.style.removeProperty('will-change');
            cromuriActive.delete(i);
          }
          continue;
        }
        if (!cromuriActive.has(i)) {
          cromuriActive.add(i);
          el.style.willChange = 'transform';
        }

        const e = pc * pc * (3 - 2 * pc);
        /* `scale` se oprește la 1 de la pc = 0.8 (unde e deja 0.9985). De
           acolo în sus, scalarea și `backdrop-filter`-ul de pe registrul
           închis sunt strict disjuncte în timp: blurul nu recalculează
           niciodată o geometrie care se schimbă. Ăsta e motivul pentru care
           numărul e 0.8 și nu 0.9. */
        el.style.setProperty('--pc-s', pc >= 0.8 ? '1' : (0.955 + 0.045 * e).toFixed(4));
        el.style.setProperty('--pc-o', (0.3 + 0.7 * e).toFixed(3));

        /* ── Licărirea: LATCH, nu scrub ──────────────────────────────────
           Singura animație nescrubată din tot sistemul, și distincția e
           conceptuală, nu tehnică: licărirea marchează EVENIMENTUL sosirii,
           tot restul exprimă STAREA sosirii. Scrubată, s-ar reda invers la
           derulare înapoi și ar stroboscopa la tremuratul degetului — risc
           WCAG 2.3.1, nu doar urât.

           Histerezis 0.72 ↑ / 0.45 ↓ = o bandă de 0.27 ≈ 216px la un viewport
           de 800px. Ca s-o redeclanșezi trebuie să derulezi 216px înapoi ȘI
           216px înainte; din tremurat nu se poate obține. Plus un cooldown
           global de 400ms peste toate cele 16 carduri. */
        if (pc >= 0.72 && !armat[i] && acum >= licarPanaLa) {
          armat[i] = true;
          licarPanaLa = acum + 400;
          el.classList.add('licar');
          setTimeout(() => el.classList.remove('licar'), 210);
        } else if (pc < 0.45) {
          armat[i] = false;
        }
      }

      return inMiscare;
    }

    /* Bucla se AUTO-OPREȘTE când toate lerp-urile sunt sub 0.1px de țintă și
       repornește la următorul `scroll`. O pagină în repaus nu consumă baterie
       pe o buclă rAF care rescrie aceleași valori. */
    let ruland = false;
    function cadru() {
      if (actualizeazaScrub()) requestAnimationFrame(cadru);
      else ruland = false;
    }
    function porneste() {
      if (ruland) return;
      ruland = true;
      requestAnimationFrame(cadru);
    }

    /* ── Armarea pe gest real ─────────────────────────────────────────────
       `lenis.velocity` e senzorul, dar nu e suficient singur: un scroll
       PROGRAMAT (restaurarea poziției la reîncărcare, find-in-page,
       `scrollIntoView` dintr-un test, un `#hash` din bara de adrese) produce
       un salt uriaș într-un singur eveniment, deci o „viteză" enormă care
       n-a fost cerută de nimeni. Snap-ul se armează doar în fereastra de
       400ms după un gest fizic. Ascultătorii sunt `passive` — nu ating,
       nu întârzie și nu pot bloca scroll-ul. */
    const FEREASTRA_GEST_MS = 400;
    let ultimulGest = 0;
    const marcheazaGest = () => {
      ultimulGest = performance.now();
    };
    for (const ev of ['wheel', 'touchstart', 'touchmove'] as const) {
      window.addEventListener(ev, marcheazaGest, { passive: true });
    }

    /* Prag calibrat pe `lenis.velocity` = px/cadru. Un scroll de citire pe
       trackpad stă sub ~20; un flick de rotiță sau un swipe rapid trece
       lejer de 45. Vezi IMPLEMENTATION_NOTES.md v4 pentru măsurătorile
       reale pe care e calibrat. */
    const PRAG_VITEZA = 45;
    let racirePanaLa = 0;

    lenis.on('scroll', () => {
      actualizeazaCarduri(indexCurent());
      porneste();

      const acum = performance.now();
      if (animand() || acum < racirePanaLa) return;
      if (acum - ultimulGest > FEREASTRA_GEST_MS) return;

      const v = lenis.velocity;
      if (Math.abs(v) < PRAG_VITEZA) return;

      racirePanaLa = acum + DURATA_SALT * 1000 + 200;
      navigheazaLa(tintaInDirectia(v > 0 ? 1 : -1));
    });
    actualizeazaCarduri(indexCurent(), true);
    porneste();

    /* Coadă: un al doilea flick sosit ÎN TIMPUL saltului nu se pierde
       (fix QA #3, iterația 2 — păstrat). Nu e un al doilea senzor de
       viteză: nu decide nimic când nu se animează. E necesar tocmai pentru
       că `lock: true` face ca gestul să nu mai producă NICIUN scroll, deci
       `lenis.velocity` n-are cum să-l vadă. */
    const PRAG_COADA_WHEEL = 30; // px de deltaY într-un singur tick
    window.addEventListener(
      'wheel',
      (ev) => {
        if (!animand() || Math.abs(ev.deltaY) < PRAG_COADA_WHEEL) return;
        const directie = ev.deltaY > 0 ? 1 : -1;
        const baza = tintaCoada !== null ? tintaCoada : (tintaCurenta ?? indexCurent());
        tintaCoada = Math.min(cards.length - 1, Math.max(0, baza + directie));
      },
      { passive: true },
    );

    /* ── Ancorele CTA ─────────────────────────────────────────────────────
       Cele patru „Rezervă-ți locul" trimit la `#inscriere`. Fără rutare
       prin Lenis, click-ul ar face saltul nativ instant în mijlocul unui
       scroll interpolat — se vede ca o rupere. `preventDefault()` explicit
       (Lenis, cu `anchors: true`, NU îl face). Hash-ul se scrie manual, ca
       navigarea înapoi/înainte și partajarea linkului să rămână neatinse. */
    document.addEventListener('click', (ev) => {
      const link = (ev.target as HTMLElement | null)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
      if (!link || ev.defaultPrevented || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
      const hash = link.getAttribute('href');
      if (!hash || hash === '#') return;
      const tinta = document.querySelector<HTMLElement>(hash);
      if (!tinta) return;

      ev.preventDefault();
      animandPanaLa = performance.now() + 900;
      lenis.scrollTo(tinta, {
        duration: 0.9,
        easing: usor,
        force: true,
        onComplete: () => {
          animandPanaLa = 0;
          actualizeazaCarduri(indexCurent(), true);
        },
      });
      history.pushState(null, '', hash);
      // Focus programatic, ca saltul să conteze și pentru tastatură/cititoare
      // de ecran, nu doar vizual. `preventScroll` — mutarea o face Lenis.
      if (!tinta.hasAttribute('tabindex')) tinta.setAttribute('tabindex', '-1');
      tinta.focus({ preventScroll: true });
    });

    /* ── Tastatură: handler separat, exact ca în v2/v3 ────────────────────
       Nu interceptează când focusul e într-un control de formular (cele 5
       blocuri radio din §16 au nevoie de Space/săgeți pentru propria
       semantică; butonul de submit are nevoie de Space pentru click-ul
       nativ). Singura schimbare față de v3: saltul trece prin
       `lenis.scrollTo`, nu prin rAF-ul scris de mână. */
    const SELECTOR_INTERACTIV = 'input, textarea, select, button, [role="radiogroup"], [contenteditable="true"]';

    function focusInControl() {
      const activ = document.activeElement as HTMLElement | null;
      return !!(activ && activ.closest && activ.closest(SELECTOR_INTERACTIV));
    }

    window.addEventListener('keydown', (ev) => {
      if (focusInControl()) return;

      const tasteJos = ['PageDown', ' ', 'Spacebar', 'ArrowDown'];
      const tasteSus = ['PageUp', 'ArrowUp'];
      if (![...tasteJos, ...tasteSus].includes(ev.key)) return;

      ev.preventDefault();
      if (animand()) return;

      const directie = tasteSus.includes(ev.key) ? -1 : 1;
      navigheazaLa(indexCurent() + directie);
    });

    /* ── Tilt 3D pe PLACA de sticlă ───────────────────────────────────────
       Recalibrat în jos, nu în sus (brief v4): o placă cu margini vizibile
       și umbră proprie dă creierului o referință de paralaxă pe care
       conținutul fără contur din v2 n-o avea, deci același unghi citește
       mult mai puternic. 2° → 1.2°, perspective 1600 → 2000px, `translateZ`
       6px → 0 (ridicarea o dă umbra, nu translația).

       `[data-tilt="card"]` stă acum pe `.continut.sticla`, NU pe
       `<section>`: pe secțiune ar fi înclinat și Câmpul, iar paralaxa —
       singurul motiv pentru care efectul se vede — ar fi dispărut. */
    const MAX_GRADE_CARD = 1.2;
    const placi = document.querySelectorAll<HTMLElement>('[data-tilt="card"]');

    function tiltCard(placa: HTMLElement, clientX: number, clientY: number) {
      const r = placa.getBoundingClientRect();
      const x = (clientX - r.left) / r.width - 0.5;
      const y = (clientY - r.top) / r.height - 0.5;
      return `perspective(2000px) rotateX(${(-y * MAX_GRADE_CARD).toFixed(2)}deg) rotateY(${(x * MAX_GRADE_CARD).toFixed(2)}deg)`;
    }

    const poatePlana = window.matchMedia('(hover: hover) and (pointer: fine)');
    if (poatePlana.matches) {
      placi.forEach((placa) => {
        placa.addEventListener('pointermove', (ev) => {
          placa.style.transform = tiltCard(placa, ev.clientX, ev.clientY);
        });
        placa.addEventListener('pointerleave', () => {
          placa.style.transform = '';
        });
      });
    } else if ('ontouchstart' in window) {
      placi.forEach((placa) => {
        placa.addEventListener(
          'touchstart',
          (ev) => {
            // `touches[0]` poate lipsi (un `touchstart` sintetic, sau un gest
            // deja anulat de browser înainte să ajungă la noi). Fără atingere
            // nu există punct de referință pentru tilt — nu facem nimic, în
            // loc să scriem `NaNdeg` în `transform` și să ascundem placa.
            const t = ev.touches[0];
            if (!t) return;
            placa.style.transform = tiltCard(placa, t.clientX, t.clientY);
          },
          { passive: true },
        );
        placa.addEventListener('touchend', () => { placa.style.transform = ''; }, { passive: true });
        placa.addEventListener('touchcancel', () => { placa.style.transform = ''; }, { passive: true });
      });
    }
  })();
</script>
