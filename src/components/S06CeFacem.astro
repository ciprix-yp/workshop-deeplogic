---
import { ceFacem } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

{/*
  Singura secțiune animată la scroll din toată pagina (pivot 2026-09-01) —
  restul e static prin construcție. Container pinat, cei cinci pași se
  dezvăluie pe măsură ce se scrollează prin el (GSAP ScrollTrigger, scriptul
  de mai jos). Guard obligatoriu de `prefers-reduced-motion`: dacă e activ,
  pașii rămân direct vizibili, fără pin.
*/}
<Sectiune id="ce-facem" reveal={false}>
  <h2>{ceFacem.h2}</h2>

  <div class="blocuri">
    {ceFacem.blocuri.map((bloc) => (
      <article class="bloc card-depth" data-pas>
        <p class="numar" aria-hidden="true">{bloc.numar}</p>
        <div class="corp">
          <h3>{bloc.titlu}</h3>
          {bloc.corp.map((p) => <p>{p}</p>)}
        </div>
      </article>
    ))}
  </div>

  {/*
    Răspunde direct fricii „n-o să știu ce să întreb, o să par prost în fața
    altor antreprenori". E motivul principal de neînscriere la un format ca
    ăsta — deci nu se îngroapă vizual într-o notă de subsol.
  */}
  <aside class="format">
    {ceFacem.notaFormat.map((p) => <p>{p}</p>)}
  </aside>

  <p class="final">{ceFacem.final}</p>
</Sectiune>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sectiune = document.getElementById('ce-facem');
  const pasi = sectiune ? Array.from(sectiune.querySelectorAll('[data-pas]')) : [];

  if (!reduceMotion && sectiune && pasi.length) {
    /*
     * Fix (audit impeccable, 2026-09-01): pin-ul ținea `#ce-facem` fixat pe
     * ecran cât timp se scruba prin el — corect pe desktop, unde grila de 3
     * coloane încape într-un viewport obișnuit, dar secțiunea stivuită pe
     * mobil (1 coloană × 5 pași + notă + linie finală) e mai înaltă decât
     * viewportul (măsurat: 1071px pe un 844px). Rezultatul: pașii 4-5 și
     * încheierea treceau complet sub fold, invizibile pe tot parcursul
     * scrub-ului, apărând abia după ce pin-ul se elibera — un scroll rapid
     * peste conținut pe care nimeni nu apuca să-l citească.
     *
     * `matchMedia` la 64rem — același prag la care `.blocuri` devine grilă
     * de 3 coloane mai jos — separă cele două cazuri: pin + scrub doar unde
     * încape într-un ecran, dezvăluire simplă la intrare, fără pin, sub el.
     */
    // `gsap.matchMedia()`, nu `ScrollTrigger.matchMedia()` (deprecat din GSAP
    // 3.11+, semnalat de `astro check`).
    const mm = gsap.matchMedia();
    mm.add('(min-width: 64rem)', () => {
      gsap.set(pasi, { opacity: 0, y: 32 });
      gsap.timeline({
        scrollTrigger: {
          trigger: sectiune,
          start: 'top top',
          // 350px de scroll per pas — suficient cât să simtă fiecare pas
          // propriul moment, fără să transforme secțiunea într-o derulare
          // interminabilă.
          end: `+=${pasi.length * 350}`,
          scrub: true,
          pin: true,
        },
      }).to(pasi, { opacity: 1, y: 0, stagger: 1, ease: 'none' });
    });
    mm.add('(max-width: 63.99rem)', () => {
      pasi.forEach((pas) => {
        gsap.set(pas, { opacity: 0, y: 24 });
        gsap.to(pas, {
          opacity: 1,
          y: 0,
          ease: 'power1.out',
          duration: 0.5,
          scrollTrigger: { trigger: pas, start: 'top 85%' },
        });
      });
    });
  }
  // Cu mișcare redusă: `gsap.set` nu rulează, pașii rămân la starea lor
  // naturală din CSS — vizibili direct, fără pin, fără scrub.
</script>

<style>
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  /*
   * Retunat (iterația 2, QA #2): gap redus de la `--sp-xl` la `--sp-lg`, și
   * cele trei blocuri trec pe 3 coloane de la ≥64rem — același pattern ca
   * S02Problema.astro și S09UseCases (grid responsive pentru elemente
   * scurte multiple, în loc de stivuire verticală nelimitată). Verificat
   * live: elimină overflow-ul rezidual la 1920×1080.
   */
  .blocuri {
    display: grid;
    gap: var(--sp-md);
  }

  @media (min-width: 64rem) {
    .blocuri {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Aspect (umbră + muchie degrade accent→lime) din `.card-depth`, global —
     vezi tokens.css. Fără `.card-3d`/tilt aici: GSAP deține deja `transform`
     pe elementul ăsta (pin/scrub, mai jos) — un `element.style.transform`
     scris de GSAP câștigă mereu în fața clasei CSS, deci tilt-ul ar muri
     tăcut, nu doar redundant. */
  .bloc {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-sm);
    align-items: start;
    padding: var(--sp-sm);
  }

  .numar {
    font-family: var(--font-mono);
    /*
     * Fix de contrast (audit impeccable, 2026-09-01): `--accent-decor` e
     * 4.06:1 — trece AA doar la ≥24px (regula e documentată chiar pe token,
     * în tokens.css). Fosta valoare `var(--t-h3)` cobora sub 24px la
     * viewporturi înguste (20px la 360px lățime) — sub prag exact acolo
     * unde majoritatea traficului chiar citește pagina. Clamp propriu, cu
     * podea la 24px indiferent de viewport.
     */
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    font-weight: 500;
    color: var(--accent-decor);
    line-height: 1;
  }

  .corp {
    display: grid;
    gap: var(--sp-xs);
  }

  h3 {
    font-size: var(--t-corp-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .format {
    margin-top: var(--sp-md);
    padding: var(--sp-sm) var(--sp-lg);
    background: var(--succes-bg);
    border-radius: var(--radius-lg);
    display: grid;
    gap: var(--sp-2xs);
    /* Text pe fundalul de succes: 9.33:1 — verificat. */
    color: var(--text);
  }

  .final {
    margin-top: var(--sp-md);
    color: var(--secundar);
  }
</style>
