---
import { ceFacem } from '../content/copy';
import Sectiune from './Sectiune.astro';

/** Scena „sala" — vezi docs/design/storyboard.json. */
const NUME_BLOC = ['bloc-conversatia', 'bloc-delegarea', 'bloc-agentul'];
---

<Sectiune id="ce-facem" scene="sala">
  <h2>{ceFacem.h2}</h2>

  <div class="blocuri">
    {ceFacem.blocuri.map((bloc, i) => (
      // Vezi S09UseCases pentru motivul separării: `.bloc` (data-el, scrubuit
      // de MotionEngine) și `.bloc-tilt` (data-tilt, urmărește cursorul) nu pot
      // trăi pe același element fără ca tranzițiile lor să se bată pe `transform`.
      <article class="bloc" data-el={NUME_BLOC[i]}>
        <div class="bloc-tilt" data-tilt>
          <p class="numar" aria-hidden="true">{bloc.numar}</p>
          <div class="corp">
            <h3>{bloc.titlu}</h3>
            {bloc.corp.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </article>
    ))}
  </div>

  {/*
    Răspunde direct fricii „n-o să știu ce să întreb, o să par prost în fața
    altor antreprenori". E motivul principal de neînscriere la un format ca
    ăsta — deci nu se îngroapă vizual într-o notă de subsol.
  */}
  <aside class="format" data-el="nota-format">
    {ceFacem.notaFormat.map((p) => <p>{p}</p>)}
  </aside>

  <p class="final">{ceFacem.final}</p>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  /*
   * Retunat (iterația 2, QA #2): gap redus de la `--sp-xl` la `--sp-lg`, și
   * cele trei blocuri trec pe 3 coloane de la ≥64rem — același pattern ca
   * S02Problema.astro și S09UseCases (grid responsive pentru elemente
   * scurte multiple, în loc de stivuire verticală nelimitată). Verificat
   * live: elimină overflow-ul rezidual la 1920×1080.
   */
  .blocuri {
    display: grid;
    gap: var(--sp-lg);
  }

  @media (min-width: 64rem) {
    .blocuri {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bloc {
    display: grid;
  }

  .bloc-tilt {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-md);
    align-items: start;
    padding: var(--sp-md);
    border: 1px solid rgba(47, 79, 79, 0.15);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .numar {
    font-family: var(--font-mono);
    font-size: var(--t-h3);
    font-weight: 500;
    /* Accent decorativ la dimensiune mare — peste pragul de 24px unde 4.06:1
       trece AA Large. */
    color: var(--accent-decor);
    line-height: 1;
  }

  .corp {
    display: grid;
    gap: var(--sp-xs);
  }

  h3 {
    font-size: var(--t-corp-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .format {
    margin-top: var(--sp-lg);
    padding: var(--sp-sm) var(--sp-lg);
    background: var(--succes-bg);
    border-radius: var(--radius-lg);
    display: grid;
    gap: var(--sp-2xs);
    /* Text pe fundalul de succes: 9.33:1 — verificat. */
    color: var(--text);
  }

  .final {
    margin-top: var(--sp-md);
    color: var(--secundar);
  }
</style>
