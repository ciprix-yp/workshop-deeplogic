---
import { CTA } from '../content/copy';

interface Props {
  /** `mare` doar în hero și în §16. Restul repetărilor sunt inline, mai discrete. */
  marime?: 'mare' | 'normal';
  /**
   * Spațiul de deasupra se declară AICI, nu printr-o clasă dată de părinte.
   *
   * Astro izolează CSS-ul pe componentă, printr-un atribut `data-astro-cid-*`
   * unic. Elementul rădăcină de mai jos poartă scope-ul acestui fișier, deci
   * o regulă `.ceva { margin-top: … }` scrisă în `<style>`-ul părintelui nu-l
   * atinge niciodată — clasa ajunge în HTML, regula ajunge în CSS, și nu se
   * întâlnesc. Fără eroare, fără avertisment: se vede doar în captură.
   */
  spatiuSus?: boolean;
  /** Pe fundal închis, butonul se inversează: accent clar cu text închis. */
  pe?: 'deschis' | 'inchis';
}
const { marime = 'normal', spatiuSus = false, pe = 'deschis' } = Astro.props;
---

<div class:list={['invelis', spatiuSus && 'spatiu-sus']}>
  <a href={CTA.ancora} class:list={['cta', marime, pe === 'inchis' && 'pe-inchis']}>
    {CTA.text}
    {/*
      Insignă de locuri live — completată de BaraScarcity.astro după ce
      răspunde /api/locuri-disponibile. Fără JS sau dacă fetch-ul eșuează,
      rămâne goală și `hidden`: butonul citește exact „Rezervă-ți locul",
      niciodată un număr inventat.
    */}
    <span class="locuri-cta" data-locuri-cta hidden></span>
  </a>
  <slot />
</div>

<style>
  .invelis {
    display: flex;
    flex-direction: column;
    gap: var(--sp-sm);
    align-items: flex-start;
  }

  .invelis.spatiu-sus {
    margin-top: var(--sp-xl);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;                     /* 6.15:1 — verificat de npm run contrast */
    font-family: var(--font-titlu);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
    /* Ținta de atingere: 44px e pragul WCAG 2.2 și, practic, lățimea unui deget
       pe un telefon ținut cu o mână. */
    min-height: var(--touch);
    padding: var(--sp-sm) var(--sp-lg);
    transition:
      background-color 0.15s ease,
      transform 0.15s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.15s ease;
  }

  /* Doar pe pointer fin (mouse real) — pe touch, „hover" rămâne lipit după
     atingere și butonul ar arăta permanent ridicat. */
  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px -6px rgba(55, 106, 102, 0.45);
    }
  }

  .cta.mare {
    font-size: var(--t-corp-lg);
    padding: var(--sp-md) var(--sp-xl);
    /* Pe mobil ocupă toată lățimea — degetul nu trebuie să caute ținta. */
    width: 100%;
  }

  @media (min-width: 40rem) {
    .cta.mare {
      width: auto;
    }
  }

  .cta:hover,
  .cta:focus-visible {
    background: var(--accent-hover);
  }

  .cta:active {
    transform: translateY(1px) scale(0.985);
    box-shadow: none;
    transition-duration: 0.08s;
  }

  /* Pe întuneric butonul se inversează. Accentul închis (#376A66) pe fundal
     #1B2426 ar da 2.6:1 — invizibil. Verificat în npm run contrast. */
  .cta.pe-inchis {
    background: var(--accent-clar);
    color: var(--bg-inchis);
  }

  .cta.pe-inchis:hover,
  .cta.pe-inchis:focus-visible {
    background: #a3e2d8;
  }

  .locuri-cta {
    margin-left: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.8em;
    font-weight: 400;
    opacity: 0.85;
  }

  @media (hover: hover) and (pointer: fine) {
    .cta.pe-inchis:hover {
      box-shadow: 0 6px 16px -6px rgba(127, 209, 196, 0.5);
    }
  }
</style>
