---
import { CTA } from '../content/copy';

interface Props {
  /** `mare` doar în hero și în CTA final. Restul repetărilor sunt inline, mai discrete. */
  marime?: 'mare' | 'normal';
  /**
   * Spațiul de deasupra se declară AICI, nu printr-o clasă dată de părinte.
   *
   * Astro izolează CSS-ul pe componentă, printr-un atribut `data-astro-cid-*`
   * unic. Elementul rădăcină de mai jos poartă scope-ul acestui fișier, deci
   * o regulă `.ceva { margin-top: … }` scrisă în `<style>`-ul părintelui nu-l
   * atinge niciodată — clasa ajunge în HTML, regula ajunge în CSS, și nu se
   * întâlnesc. Fără eroare, fără avertisment: se vede doar în captură.
   */
  spatiuSus?: boolean;
}
const { marime = 'normal', spatiuSus = false } = Astro.props;
---

<div class:list={['invelis', spatiuSus && 'spatiu-sus']}>
  <a href={CTA.ancora} class:list={['cta', marime]}>{CTA.text}</a>
  {/*
    Numărul real de locuri, SUB buton — cerut explicit (2026-09-02), nu mai
    inline în text. Completat de BaraScarcity.astro după ce răspunde
    /api/locuri-disponibile. Fără JS sau dacă fetch-ul eșuează, rămâne gol
    și `hidden`: pagina nu arată niciodată un număr inventat.
  */}
  <p class="locuri-cta" data-locuri-cta hidden></p>
  <slot />
</div>

<style>
  .invelis {
    display: flex;
    flex-direction: column;
    gap: var(--sp-xs);
    align-items: flex-start;
  }

  .invelis.spatiu-sus {
    margin-top: var(--sp-xl);
  }

  /*
   * Fundal lime (cerut explicit, 2026-09-02) — text pe `--pe-lime`
   * (= --bg-inchis, 8.01:1), nu alb: alb pe acest lime ar da ~1.6:1,
   * ilizibil. Vezi comentariul din tokens.css.
   */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--lime);
    color: var(--pe-lime);
    font-family: var(--font-titlu);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-cta);
    /* Ținta de atingere: 44px e pragul WCAG 2.2 și, practic, lățimea unui deget
       pe un telefon ținut cu o mână. */
    min-height: var(--touch);
    padding: var(--sp-sm) var(--sp-lg);
    transition:
      background-color 0.15s ease,
      transform 0.15s var(--ease-out),
      box-shadow 0.15s ease;
  }

  /* Doar pe pointer fin (mouse real) — pe touch, „hover" rămâne lipit după
     atingere și butonul ar arăta permanent ridicat. */
  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 20px -6px rgba(132, 204, 22, 0.55);
    }
  }

  .cta.mare {
    font-size: var(--t-corp-lg);
    padding: var(--sp-md) var(--sp-xl);
    /* Pe mobil ocupă toată lățimea — degetul nu trebuie să caute ținta. */
    width: 100%;
  }

  @media (min-width: 40rem) {
    .cta.mare {
      width: auto;
    }
  }

  .cta:hover,
  .cta:focus-visible {
    background: var(--lime-hover);
  }

  .cta:active {
    transform: translateY(1px) scale(0.97);
    box-shadow: none;
    transition-duration: 0.08s;
  }

  .locuri-cta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mic);
    font-weight: 500;
    color: var(--secundar);
    /* Fix (audit emil-design-eng, 2026-09-01): `el.hidden = false` arăta
       numărul instant, fără nicio tranziție. `@starting-style` animă exact
       momentul în care `hidden` e scos. */
    opacity: 1;
    transition: opacity 200ms var(--ease-out);

    @starting-style {
      opacity: 0;
    }
  }
</style>
