---
import { inscriere, CTA, stari } from '../content/copy';
import { BLOCURI, BIFE, SURSA_CONDITIONAL } from '../content/form-schema';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

/*
 * Bug real, găsit 2026-09-02 („de ce arată widget-ul roșu, cu «numai pentru
 * testare»?"): varianta veche citea `import.meta.env.PUBLIC_TURNSTILE_SITE_KEY`
 * — proiectul NU expune variabilele așa, ci prin `astro:env/client`
 * (`PUBLIC_SITE_URL` în `src/inngest/*` e exact același tipar). Acea citire
 * era mereu `undefined`, deci fallback-ul local (`?? '1x00...AA'`, cheia de
 * TEST publică a Cloudflare) se activa NECONDIȚIONAT — inclusiv în producție,
 * unde `wrangler.jsonc` are cheia reală. Cheia de test afișează avertismentul
 * roșu ȘI nu se potrivește cu `TURNSTILE_SECRET_KEY` real de pe server, deci
 * `verificaTurnstile()` (src/lib/turnstile.ts) pica probabil la fiecare
 * submit real. Fix: import direct din `astro:env/client` — fără fallback
 * local, schema din `astro.config.mjs` cere câmpul obligatoriu, deci un
 * build fără el pică zgomotos la build, nu tăcut la runtime.
 */
const siteKey = PUBLIC_TURNSTILE_SITE_KEY;

/** Sursele care deschid un câmp suplimentar, serializate pentru scriptul de pe client. */
const conditionale = JSON.stringify(SURSA_CONDITIONAL);

/**
 * Cele patru stări posibile după un submit reușit (vezi `stareaPentruClient`
 * în src/pages/api/register.ts) — trimise la client ca să randeze confirmarea
 * ÎN dialog, fără navigare. `/multumesc`/`/lista-asteptare` rămân ținta reală
 * pentru submit-ul nativ (JS oprit/eșuat) — regula B2 nu se atinge, POST-ul
 * mută starea exact ca înainte, doar prezentarea diferă pentru clientul cu JS.
 */
const stariClient = JSON.stringify({
  inscris: stari.inscris,
  asteptare: stari.asteptare,
  reconfirmat: stari.reconfirmat,
  anulatAnterior: stari.anulatAnterior,
});
---

{/*
  Formularul, într-un `<dialog>` — nu o secțiune în flux.

  `open` ca atribut static, în HTML-ul randat pe server: fără JS, dialogul se
  comportă ca un bloc normal, în flux, exact unde e plasat în DOM — un
  formular funcțional, accesibil prin ancora `#inscriere`, POST nativ către
  /api/register. Cu JS activ, scriptul de mai jos apelează `.close()`
  SINCRON, înainte de primul paint — nu există cadru intermediar în care
  dialogul apare deschis, apoi dispare. CTA-urile (Cta.astro,
  `href="#inscriere"`) rămân neschimbate:
  scriptul le interceptează global și cheamă `.showModal()` în loc să lase
  browserul să sară la ancoră.
*/}
<dialog id="inscriere" class="dialog-inscriere" aria-labelledby="dialog-titlu" open>
  <button type="button" class="inchide" data-inchide aria-label="Închide fereastra">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
    </svg>
  </button>

  <div class="continut">
    <h2 id="dialog-titlu">{inscriere.h2}</h2>

    <div data-pas="formular">
      <p class="corp">{inscriere.corp}</p>
      <p class="meta">{inscriere.meta}</p>
      {/*
        Numărul live de locuri — completat de scriptul din BaraScarcity.astro
        (aceeași sursă unică de date, același selector `data-locuri-*` pe care
        îl actualizează deja insigna de pe CTA-uri). Nu un fetch separat aici:
        două cicluri de reîmprospătare independente ar putea afișa, o clipă,
        două numere diferite pe același ecran.
      */}
      <p class="locuri-live" data-locuri-live hidden></p>

      <form id="form-inscriere" method="POST" action="/api/register" novalidate>
        {BLOCURI.map((bloc) => (
          <fieldset class="bloc">
            {bloc.titlu && (
              <legend>
                <span class="legend-titlu">{bloc.titlu}</span>
                {bloc.intro && <span class="legend-intro">{bloc.intro}</span>}
              </legend>
            )}

            {bloc.campuri.map((camp) => (
              <div class:list={['camp', `tip-${camp.tip}`]} data-camp={camp.id}>
                {camp.tip === 'radio' ? (
                  <fieldset class="grup-radio">
                    <legend class="eticheta">{camp.label}</legend>
                    <div class="optiuni">
                      {camp.optiuni?.map((op) => (
                        <label class="optiune">
                          <input
                            type="radio"
                            name={camp.id}
                            value={op}
                            required={camp.obligatoriu}
                            aria-describedby={`${camp.id}-eroare`}
                          />
                          <span>{op}</span>
                        </label>
                      ))}
                    </div>
                    <p class="eroare" id={`${camp.id}-eroare`} role="alert" aria-live="polite"></p>
                  </fieldset>
                ) : (
                  <>
                    <label class="eticheta" for={camp.id}>{camp.label}</label>
                    {camp.microcopy && (
                      <p class="microcopy" id={`${camp.id}-ajutor`}>{camp.microcopy}</p>
                    )}

                    {camp.tip === 'textarea' ? (
                      <textarea
                        id={camp.id}
                        name={camp.id}
                        rows="3"
                        required={camp.obligatoriu}
                        placeholder={camp.placeholder}
                        aria-describedby={`${camp.id}-eroare${camp.microcopy ? ` ${camp.id}-ajutor` : ''}`}
                      ></textarea>
                    ) : camp.tip === 'select' ? (
                      <select
                        id={camp.id}
                        name={camp.id}
                        required={camp.obligatoriu}
                        aria-describedby={`${camp.id}-eroare`}
                      >
                        <option value="">Alege…</option>
                        {camp.optiuni?.map((op) => <option value={op}>{op}</option>)}
                      </select>
                    ) : (
                      <input
                        type={camp.tip}
                        id={camp.id}
                        name={camp.id}
                        required={camp.obligatoriu}
                        autocomplete={camp.autocomplete}
                        placeholder={camp.placeholder}
                        aria-describedby={`${camp.id}-eroare${camp.microcopy ? ` ${camp.id}-ajutor` : ''}`}
                      />
                    )}

                    <p class="eroare" id={`${camp.id}-eroare`} role="alert" aria-live="polite"></p>
                  </>
                )}
              </div>
            ))}

            {bloc.id === 'cine' && (
              <div class="camp tip-text" id="camp-sursa-detaliu" hidden>
                <label class="eticheta" for="sursa_detaliu" id="eticheta-sursa-detaliu">De la cine?</label>
                <input type="text" id="sursa_detaliu" name="sursa_detaliu"
                       aria-describedby="sursa_detaliu-eroare" />
                <p class="eroare" id="sursa_detaliu-eroare" role="alert" aria-live="polite"></p>
              </div>
            )}
          </fieldset>
        ))}

        <div class="bife">
          <label class="bifa">
            <input type="checkbox" name={BIFE.consimtamant.id} value="true" required
                   aria-describedby="consimtamant-eroare consimtamant-politica" />
            <span>{BIFE.consimtamant.label}</span>
          </label>
          <p class="link-politica" id="consimtamant-politica">
            <a href={BIFE.consimtamant.linkPolitica.href} target="_blank" rel="noopener">
              {BIFE.consimtamant.linkPolitica.text}
            </a>
          </p>
          <p class="eroare" id="consimtamant-eroare" role="alert" aria-live="polite"></p>

          <label class="bifa">
            <input type="checkbox" name={BIFE.discutie.id} value="true" />
            <span>
              {BIFE.discutie.label}
              <span class="microcopy">{BIFE.discutie.microcopy}</span>
            </span>
          </label>
        </div>

        <div class="turnstile-invelis">
          <div class="cf-turnstile" data-sitekey={siteKey} data-language="ro" data-theme="light"></div>
          <p class="eroare" id="turnstile-eroare" role="alert" aria-live="polite"></p>
        </div>

        <div class="trimite">
          <button type="submit" class="cta-submit">{CTA.text}</button>
          <p class="microcopy sub-cta">{inscriere.microcopy}</p>
        </div>

        {/* Rezultatul, când JS-ul e activ și submit-ul EȘUEAZĂ. Confirmarea de
            succes trăiește în `[data-pas="confirmare"]`, nu aici. Fără JS,
            API-ul face redirect. */}
        <div id="rezultat" class="rezultat" role="status" aria-live="polite" hidden></div>
      </form>
    </div>

    <div data-pas="confirmare" hidden>
      <div data-confirmare-corp class="confirmare-corp"></div>
      <a class="inapoi" href="/">← Înapoi la pagina workshopului</a>
    </div>
  </div>
</dialog>

{/*
  Fără `integrity` — deliberat, nu din omisiune (vezi comentariul original,
  S16Inscriere.astro/git history). Cloudflare publică `api.js` fără
  versionare și îl actualizează continuu; documentația lor spune explicit
  să NU se folosească SRI pe el, pentru că un hash fix ar rupe widget-ul la
  prima actualizare de partea lor. Riscul rezidual e limitat: validarea
  reală se face pe server, unde tokenul e verificat împotriva API-ului
  Cloudflare — un script compromis ar produce cel mult tokeni invalizi, nu
  ar ocoli verificarea.
*/}
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script is:inline define:vars={{ conditionale, stariClient }}>
  (() => {
    const dialog = document.getElementById('inscriere');
    const form = document.getElementById('form-inscriere');
    if (!dialog || !form) return;

    const STARI = JSON.parse(stariClient);
    const COND = JSON.parse(conditionale);

    // ── No-JS → JS: normalizează starea înainte de primul paint ───────────
    // Fără asta, dialogul (randat `open` pentru clientul fără JS) ar apărea
    // o clipă ca bloc inline, apoi ar „sări" la închis — exact fereastra de
    // FOUC pe care restul scripturilor din proiect o evită prin poziționare.
    //
    // `.cu-js` marchează prezența JS-ului ÎNAINTE de primul paint, în același
    // script sincron — CSS-ul de intrare/ieșire (`@starting-style`, vezi
    // stilurile de mai jos) e scopat la ea. Fără asta, `@starting-style`
    // pornește și pe randarea statică (fără JS): elementul e deja `[open]`
    // la primul paint, deci browserul tot tratează ăla ca „prima stilizare"
    // și rulează o tranziție de 220ms nesolicitată — verificat empiric,
    // instabilă (dialogul e `position: absolute` din stilul implicit al
    // `<dialog>`, centrat cu margini automate pe toată înălțimea
    // documentului; `scale`-ul în mișcare îi schimbă cutia, deci și offsetul
    // de centrare, cadru cu cadru).
    dialog.classList.add('cu-js');
    dialog.close();

    function deschide() {
      dialog.showModal();
    }
    function inchide() {
      dialog.close();
    }

    // Orice link către #inscriere (CTA.astro, repetat de 4 ori pe pagină)
    // deschide dialogul în loc să sară la ancoră.
    document.addEventListener('click', (ev) => {
      const link = ev.target.closest?.('a[href="#inscriere"]');
      if (!link) return;
      ev.preventDefault();
      deschide();
    });

    dialog.querySelector('[data-inchide]')?.addEventListener('click', inchide);

    // Click pe `::backdrop` — singurul caz în care `event.target` e chiar
    // `<dialog>`, nu un descendent (conținutul e într-un `<div>` interior).
    dialog.addEventListener('click', (ev) => {
      if (ev.target === dialog) inchide();
    });
    // ESC e nativ (`<dialog>` emite `cancel` apoi `close`) — nimic de scris.

    // ── Câmpul condiționat „De la cine?" ───────────────────────────────────
    const sursa = form.querySelector('#sursa');
    const wrapDetaliu = document.getElementById('camp-sursa-detaliu');
    const etichetaDetaliu = document.getElementById('eticheta-sursa-detaliu');
    const inputDetaliu = document.getElementById('sursa_detaliu');

    function actualizeazaDetaliu() {
      const cerut = COND[sursa?.value ?? ''];
      if (cerut) {
        etichetaDetaliu.textContent = cerut;
        wrapDetaliu.hidden = false;
        inputDetaliu.required = true;
      } else {
        wrapDetaliu.hidden = true;
        inputDetaliu.required = false;
        inputDetaliu.value = '';
      }
    }
    sursa?.addEventListener('change', actualizeazaDetaliu);
    actualizeazaDetaliu();

    function stergeErori() {
      form.querySelectorAll('.eroare').forEach((e) => (e.textContent = ''));
      form.querySelectorAll('[aria-invalid]').forEach((e) => e.removeAttribute('aria-invalid'));
    }

    function arataErori(erori) {
      let primul = null;
      for (const [camp, mesaj] of Object.entries(erori)) {
        const tinta = document.getElementById(`${camp}-eroare`);
        if (tinta) tinta.textContent = mesaj;
        const control = form.querySelector(`[name="${camp}"]`);
        if (control) {
          control.setAttribute('aria-invalid', 'true');
          if (!primul) primul = control;
        }
      }
      if (primul) {
        primul.focus({ preventScroll: true });
        primul.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    // ── Confirmarea, ÎN dialog — nu navigare ───────────────────────────────
    const pasFormular = dialog.querySelector('[data-pas="formular"]');
    const pasConfirmare = dialog.querySelector('[data-pas="confirmare"]');
    const titluDialog = document.getElementById('dialog-titlu');
    const confirmareCorp = dialog.querySelector('[data-confirmare-corp]');

    function arataConfirmarea(stare) {
      const continut = STARI[stare] ?? STARI.inscris;
      titluDialog.textContent = continut.titlu;
      confirmareCorp.replaceChildren(
        ...continut.corp.map((p) => {
          const el = document.createElement('p');
          el.textContent = p;
          return el;
        }),
      );
      pasFormular.hidden = true;
      pasConfirmare.hidden = false;
      // Mutare de focus pe titlu — cine navighează cu tastatura/cititor de
      // ecran trebuie să afle imediat ce s-a întâmplat, nu doar să vadă.
      titluDialog.setAttribute('tabindex', '-1');
      titluDialog.focus();
    }

    const buton = form.querySelector('.cta-submit');
    const textInitial = buton.textContent;
    const rezultat = document.getElementById('rezultat');

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      stergeErori();
      buton.disabled = true;
      buton.textContent = 'Se trimite…';

      try {
        const r = await fetch('/api/register', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const date = await r.json();

        if (date.ok) {
          arataConfirmarea(date.stare);
          return;
        }

        if (date.erori) arataErori(date.erori);
        else {
          rezultat.hidden = false;
          rezultat.textContent = date.mesaj ?? 'Ceva s-a rupt. Încearcă din nou.';
        }
        if (window.turnstile) window.turnstile.reset();
      } catch {
        rezultat.hidden = false;
        rezultat.textContent =
          'N-am putut trimite. Verifică conexiunea și încearcă din nou.';
        if (window.turnstile) window.turnstile.reset();
      } finally {
        buton.disabled = false;
        buton.textContent = textInitial;
      }
    });
  })();
</script>

<style>
  .dialog-inscriere {
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    max-width: min(40rem, calc(100vw - 2 * var(--lat)));
    width: 100%;
    max-height: min(90dvh, 52rem);
    box-shadow: 0 24px 64px -16px rgba(27, 36, 38, 0.35);
  }

  /*
   * Intrare/ieșire (audit emil-design-eng, 2026-09-01) — înainte, `showModal()`
   * și `.close()` săreau instant, fără nicio tranziție; dialogul cel mai
   * important de pe pagină se comporta ca și cum ar fi rupt. `[open]` +
   * `@starting-style` + `allow-discrete` animă AMBELE sensuri fără nicio
   * schimbare în JS: cele trei căi de închidere (X, backdrop, ESC nativ) tot
   * apelează `.close()` direct — CSS-ul ține elementul randat pe durata
   * tranziției înainte să-l scoată efectiv din top layer.
   *
   * `transform-origin: center`, nu ancorat la un trigger — modalele rămân
   * centrate (excepția explicită din regula „popover-urile pornesc de la
   * trigger").
   *
   * Scopat la `.cu-js` (adăugată sincron, înainte de primul paint — vezi
   * scriptul de mai jos): fără JS, dialogul e randat `open` static din prima
   * — `@starting-style` ar trata ȘI ăla ca „prima stilizare" și ar anima o
   * intrare nesolicitată pe încărcarea paginii, pentru un vizitator care
   * n-a apăsat nimic.
   */
  .dialog-inscriere.cu-js {
    opacity: 0;
    scale: 0.95;
    transition: opacity 220ms var(--ease-out), scale 220ms var(--ease-out),
      display 220ms allow-discrete, overlay 220ms allow-discrete;
  }

  .dialog-inscriere.cu-js[open] {
    opacity: 1;
    scale: 1;

    @starting-style {
      opacity: 0;
      scale: 0.95;
    }
  }

  /* Fără JS: `open` static, fără `showModal()` — dialogul e un bloc normal,
     în flux, nu o fereastră plutitoare. Regulile de mai sus nu se activează
     niciodată în cazul ăsta (nimic nu tranziționează `[open]`, e deja acolo
     de la randare), iar `::backdrop` nu există niciodată în flux — nimic de
     dezactivat separat. */
  .dialog-inscriere::backdrop {
    background: rgba(27, 36, 38, 0);
    transition: background-color 220ms var(--ease-out), display 220ms allow-discrete, overlay 220ms allow-discrete;
  }

  .dialog-inscriere[open]::backdrop {
    background: rgba(27, 36, 38, 0.55);

    @starting-style {
      background: rgba(27, 36, 38, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Rămâne opacitatea (ajută la comprehensiune — ce apare/dispare), dispare
       mișcarea (scale). */
    .dialog-inscriere.cu-js,
    .dialog-inscriere.cu-js[open] {
      scale: 1;
      transition-duration: 160ms;
    }
  }

  .continut {
    max-height: min(90dvh, 52rem);
    overflow-y: auto;
    padding: var(--sp-xl) var(--sp-lg) var(--sp-lg);
  }

  @media (min-width: 40rem) {
    .continut {
      padding: var(--sp-xl);
    }
  }

  .inchide {
    position: sticky;
    float: right;
    top: var(--sp-sm);
    margin: var(--sp-sm) var(--sp-sm) 0 0;
    /* deasupra conținutului scrolabil */
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    border: none;
    border-radius: 999px;
    background: var(--bg-secundar);
    color: var(--text);
    cursor: pointer;
  }

  .inchide:hover,
  .inchide:focus-visible {
    background: rgba(47, 79, 79, 0.2);
  }

  .inchide {
    transition: transform 160ms var(--ease-out), background-color 0.15s ease;
  }

  .inchide:active {
    transform: scale(0.9);
  }

  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
    max-width: 34ch;
  }

  h2:focus-visible {
    outline: none;
  }

  .corp {
    font-size: var(--t-corp-lg);
  }

  .meta {
    font-family: var(--font-mono);
    color: var(--secundar);
    margin-top: var(--sp-md);
    margin-bottom: var(--sp-sm);
  }

  .locuri-live {
    font-family: var(--font-mono);
    font-size: var(--t-mic);
    /* Culoarea reală (alb→roșu, pe raportul de ocupare) e setată inline de
       scriptul din BaraScarcity.astro — la fel ca bara de sus, nu doar text
       static. Valoarea de-aici e un fallback vizibil doar dacă JS n-a apucat
       să seteze `style.color` încă. */
    color: var(--secundar);
    margin-bottom: var(--sp-xl);
    /* Fix (audit emil-design-eng, 2026-09-01) — vezi Cta.astro/.locuri-cta,
       același defect: apărea instant la `hidden = false`. */
    opacity: 1;
    scale: 1;
    transition: opacity 200ms var(--ease-out), scale 200ms var(--ease-out);

    @starting-style {
      opacity: 0;
      scale: 0.95;
    }
  }

  form {
    display: grid;
    gap: var(--sp-xl);
  }

  fieldset.bloc {
    border: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-md);
  }

  legend {
    padding: 0;
    margin-bottom: var(--sp-xs);
    display: grid;
    gap: var(--sp-2xs);
  }

  .legend-titlu {
    font-family: var(--font-titlu);
    font-size: var(--t-h3);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .legend-intro {
    font-size: var(--t-corp);
    font-weight: 400;
    color: var(--text-muted);
    line-height: var(--lh-normal);
    max-width: 46ch;
  }

  .camp {
    display: grid;
    gap: var(--sp-2xs);
  }

  /*
   * Fix (audit emil-design-eng, 2026-09-01) — doar la apariție: câmpul
   * condiționat „De la cine?" sărea instant la `hidden = false`. La
   * dispariție rămâne instant, deliberat — `[hidden]` are `!important` în
   * tokens.css dintr-un motiv real de accesibilitate (o secțiune anterioară
   * a proiectului a găsit un câmp ascuns care rămânea vizual vizibil din
   * cauza unui `display` mai specific din componentă); a anima ieșirea ar
   * cere să lupți cu acel `!important`, risc mai mare decât beneficiul aici.
   */
  #camp-sursa-detaliu {
    opacity: 1;
    transition: opacity 200ms var(--ease-out);

    @starting-style {
      opacity: 0;
    }
  }

  .eticheta {
    font-weight: 600;
    font-size: var(--t-corp);
    line-height: var(--lh-normal);
  }

  .microcopy {
    font-size: var(--t-eyebrow);
    color: var(--text-muted);
    line-height: var(--lh-normal);
  }

  input[type='text'],
  input[type='email'],
  textarea,
  select {
    width: 100%;
    font: inherit;
    font-size: max(1rem, var(--t-corp));
    color: var(--text);
    background: var(--bg);
    border: 1px solid rgba(47, 79, 79, 0.35);
    border-radius: var(--radius);
    padding: var(--sp-sm);
    min-height: var(--touch);
  }

  textarea {
    resize: vertical;
    min-height: 5.5rem;
    line-height: var(--lh-normal);
