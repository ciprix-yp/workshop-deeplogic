---
import { trustBar } from '../content/copy';
---

{/*
  Strip compact, imediat sub hero (secțiune nouă, pivot de structură
  2026-09-02) — tot ce trebuie știut dintr-o privire, inclusiv adresa
  completă (D6, obligatorie pe pagină — vezi tests/copy-invariants.test.ts).

  Distinct de BaraScarcity.astro (bara fixă, mereu vizibilă la scroll): asta
  e un bloc din flux, o singură dată, cu mai mult context și fără poziție
  fixă — nu concurează cu bara pentru atenție.

  Card 3D + „Adaugă în calendar" — cerut explicit (2026-09-02). Linkul duce
  la `/eveniment.ics` (generat static la build, `scripts/generate-ics.mjs` +
  `src/lib/ics.ts`), NU descarcă fișierul — fără atributul `download`,
  telefonul îl recunoaște după `Content-Type: text/calendar` și îl deschide
  direct în aplicația de calendar, precompletat: locație, dată, oră și o
  alertă cu 24h înainte (`VALARM`, adăugat în același pivot). Un singur tap,
  „Save", fără să introducă nimic manual.
*/}
<div class="trust" data-reveal>
  <div class="card card-depth card-3d" data-tilt>
    <p class="linie meta">{trustBar.meta}</p>
    <p class="linie format">{trustBar.format}</p>
    <p class="linie roadmap">{trustBar.roadmap}</p>

    <a href="/eveniment.ics" class="calendar-cta">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M3 9.5h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      Adaugă în calendar
    </a>
  </div>

  <p class="invitatie">{trustBar.invitatie}</p>
</div>

<style>
  .trust {
    background: var(--bg-secundar);
    padding-block: var(--sp-xl);
    padding-inline: var(--lat);
  }

  .card {
    max-width: var(--max-continut);
    margin-inline: auto;
    padding: var(--sp-lg);
    display: grid;
    gap: var(--sp-2xs);
  }

  .linie {
    font-family: var(--font-mono);
    font-size: var(--t-mic);
    line-height: var(--lh-normal);
    color: var(--secundar);
  }

  .meta {
    font-weight: 600;
    color: var(--text);
    font-size: var(--t-corp);
  }

  .calendar-cta {
    margin-top: var(--sp-sm);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-xs);
    justify-self: start;
    padding: var(--sp-xs) var(--sp-md);
    border-radius: var(--radius-cta);
    background: var(--lime);
    color: var(--pe-lime);
    font-family: var(--font-titlu);
    font-weight: 600;
    font-size: var(--t-mic);
    text-decoration: none;
    min-height: var(--touch);
    transition: background-color 0.15s ease, transform 0.15s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .calendar-cta:hover {
      background: var(--lime-hover);
      transform: translateY(-1px);
    }
  }

  .calendar-cta:active {
    transform: scale(0.97);
  }

  .invitatie {
    max-width: var(--max-continut);
    margin-inline: auto;
    margin-top: var(--sp-sm);
    font-size: var(--t-mic);
    font-style: italic;
    color: var(--text-muted);
  }
</style>
