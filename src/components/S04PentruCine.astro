---
import { pentruCine } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

{/*
  Filtru real, nu politețe. Cu 30 de locuri, o pagină care convinge pe toată
  lumea e un eșec.

  Cele două coloane rămân VIZUAL EGALE — aceeași dimensiune de titlu, aceeași
  culoare de text, aceeași greutate. Dacă „nu e pentru tine" arată mai mic sau
  mai gri, filtrul devine decorativ și nu mai filtrează pe nimeni.
*/}
<Sectiune id="pentru-cine" latime="larg">
  <div class="grila">
    <div class="coloana">
      <h2 data-reveal>{pentruCine.da.h2}</h2>
      <ul class="lista da">
        {pentruCine.da.lista.map((l) => <li data-reveal>{l}</li>)}
      </ul>
    </div>

    <div class="coloana">
      <h2 data-reveal>{pentruCine.nu.h2}</h2>
      <ul class="lista nu">
        {pentruCine.nu.lista.map((l) => <li data-reveal>{l}</li>)}
      </ul>
    </div>
  </div>

  {/*
    Quickwin box (2026-09-09, cerut explicit) — înlocuiește fosta linie
    despărțitoare + text simplu. Refolosește `.card-depth` (aceeași sticlă
    mată ca biletul din Trust bar, cardurile din Agravare/Soluție), nu un
    tratament nou. Cele două propoziții („nu X... Este despre Y") rămân la
    ACEEAȘI greutate — aceeași disciplină ca la cardurile „nu X / ci Y" din
    Agravare (D69) și Soluție (D77): niciun accent inventat între ele.
  */}
  <div class="outro card-depth" data-reveal>
    {pentruCine.outro.map((p) => <p>{p}</p>)}
  </div>
</Sectiune>

<style>
  .grila {
    display: grid;
    /* Retunat (iterația 2, QA #2): sp-lg în loc de sp-xl — era la doar 50px
       peste 100dvh la 360×800, cel mai apropiat card de fit perfect din
       lista raportată de QA; un gol mai mic ajunge singur să-l încapă. */
    gap: var(--sp-lg);
  }

  @media (min-width: 48rem) {
    .grila {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-2xl);
    }
  }

  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-sm);
  }

  .lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-xs);
  }

  .lista li {
    display: grid;
    /* 1.1rem, nu 1.5rem — bulina e mult mai îngustă decât fostul em-dash,
       aceeași corecție ca la §02/§05. */
    grid-template-columns: 1.1rem 1fr;
    align-items: baseline;
    /* Aceeași culoare în ambele coloane. Vezi comentariul de sus. */
    color: var(--text);
  }

  /* Bulină (`•`), nu em-dash — aliniat cu §02/§05 (2026-09-09: era ultima
     secțiune rămasă pe marcajul vechi, semnalat explicit runda trecută). */
  .lista li::before {
    content: '•';
    font-size: 1.15em;
    line-height: 1;
  }

  .da li::before {
    color: var(--accent-decor);
  }

  .nu li::before {
    color: var(--text-muted);
  }

  .outro {
    margin-top: var(--sp-xl);
    padding: var(--sp-lg);
    display: grid;
    gap: var(--sp-xs);
    max-width: 44ch;
  }

  /* Aceeași rețetă tipografică ca `.sinteza` din Soluție — corp mare,
     greutate 600, `--secundar`. Ambele rânduri, nu doar unul: „nu X / ci Y"
     rămâne fără accent inventat între cele două jumătăți. */
  .outro p {
    font-size: var(--t-corp-lg);
    font-weight: 600;
    color: var(--secundar);
    line-height: var(--lh-normal);
  }
</style>
