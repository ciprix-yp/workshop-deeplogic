---
import { problema } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

{/*
  Cea mai importantă secțiune a paginii. Nu se taie la mobil, indiferent ce —
  regulă neschimbată de pivotul de structură (2026-09-02). Rescrisă complet:
  deschide direct cu exemple concrete, nu cu un bloc de „vacarm" separat —
  absoarbe spiritul fostului grid de exemple (retras ca secțiune proprie).

  Text nou (2026-09-07, a treia rundă) — două liste scurte (simptome, apoi
  întrebările care blochează), reutilizând ACEEAȘI clasă de listă (`.lista`,
  fost `.exemple`) pentru amândouă: aceleași marcaje, aceeași culoare —
  distincția dintre ele o face intro-ul de dinaintea fiecăreia, nu un stil
  vizual diferit. Închiderea nu mai e o întrebare mare (fostul `.intrebare`);
  ultima propoziție a concluziei preia acum acel rol — vezi `<style>`.
*/}
<Sectiune id="problema" latime="larg">
  <h2 data-reveal>{problema.h2}</h2>

  <ul class="lista">
    {problema.exemple.map((linie) => (
      <li data-reveal>{linie}</li>
    ))}
  </ul>

  <p class="intrebari-intro" data-reveal>{problema.intrebariIntro}</p>

  <ul class="lista">
    {problema.intrebari.map((linie) => (
      <li data-reveal>{linie}</li>
    ))}
  </ul>

  <div class="concluzie-bloc" data-reveal>
    {problema.concluzie.map((p, i) => (
      <p class:list={['concluzie', i === problema.concluzie.length - 1 && 'concluzie-statement']}>
        {p}
      </p>
    ))}
  </div>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-statement);
    max-width: 20ch;
    margin-bottom: var(--sp-lg);
  }

  /* Fost `.exemple` — refolosită acum pentru AMBELE liste (simptome ȘI
     întrebări): același marcaj, aceeași culoare. Distincția dintre ele vine
     din intro-ul de dinaintea fiecăreia, nu dintr-un stil vizual separat. */
  .lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-sm);
    max-width: var(--max-proza);
  }

  .lista + .lista,
  .lista + .intrebari-intro {
    margin-top: var(--sp-xl);
  }

  .lista li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    align-items: baseline;
    font-size: var(--t-corp-lg);
    line-height: var(--lh-normal);
  }

  .lista li::before {
    content: '—';
    color: var(--accent-decor);
    font-weight: 600;
  }

  .intrebari-intro {
    margin-top: var(--sp-md);
    margin-bottom: var(--sp-sm);
    max-width: var(--max-proza);
    color: var(--text-muted);
    line-height: var(--lh-normal);
  }

  .concluzie-bloc {
    margin-top: var(--sp-xl);
    padding-top: var(--sp-lg);
    border-top: 1px solid rgba(47, 79, 79, 0.18);
    display: grid;
    gap: var(--sp-xs);
  }

  .concluzie {
    max-width: var(--max-proza);
    color: var(--secundar);
    line-height: var(--lh-normal);
  }

  /* Declarația de claritate a secțiunii — aceeași treabă tipografică pe care
     o făcea fostul `.intrebare` (marele „Ce problemă merită atenția ta
     acum?"): corp mare, aer deasupra, ca să se citească drept concluzia, nu
     încă o propoziție din listă. */
  .concluzie-statement {
    margin-top: var(--sp-xs);
    font-family: var(--font-titlu);
    font-weight: 700;
    font-size: var(--t-h2);
    color: var(--text);
    max-width: 26ch;
  }
</style>
