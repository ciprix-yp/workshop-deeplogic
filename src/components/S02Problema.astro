---
import { problema } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

{/*
  Cea mai importantă secțiune a paginii. Nu se taie la mobil, indiferent ce —
  regulă neschimbată de pivotul de structură (2026-09-02). Rescrisă complet:
  deschide direct cu exemple concrete, nu cu un bloc de „vacarm" separat —
  absoarbe spiritul fostului grid de exemple (retras ca secțiune proprie).

  Text nou (2026-09-07, a treia rundă) — două liste scurte (simptome, apoi
  întrebările care blochează), reutilizând ACEEAȘI clasă de listă (`.lista`)
  pentru amândouă: aceleași marcaje, aceeași culoare — distincția dintre ele
  o face titlul de deasupra fiecăreia, nu un stil vizual diferit.

  A treia corecție, aceeași zi („«Iar întrebările...» trebuie să fie la
  nivelul «Simți că unele aspecte...». Echilibrează pagina și secțiunea"):
  al doilea intro era un paragraf mic, gri — acum e `h2`, la fel ca primul,
  iar cele două perechi titlu+listă stau una lângă alta peste 52rem. Vezi
  `<style>` pentru de ce perechile și de ce `--t-h2` în loc de
  `--t-statement`.

  Corectat imediat după (aceeași zi, feedback direct: „nu este bine, am cerut
  bulets nu linii... ce ți-am dat este o secțiune, nu trebuie divizată"):
  — Marcajul e BULINĂ (`•`), nu em-dash. Prima variantă refolosea marcajul
    em-dash moștenit din fosta listă `.exemple`, ca să nu introducă un al
    doilea limbaj vizual — dar cerința era explicită, iar cerința bate
    consecvența cu un marcaj pe care oricum îl înlocuim peste tot aici.
  — Secțiunea e UN bloc continuu. Varianta dinainte avea o linie orizontală
    (`border-top`) înainte de concluzie și ultima propoziție la corp mare,
    bold — împreună, cele două citeau ca începutul unei secțiuni NOI, nu ca
    închiderea acesteia. Ambele scoase: tot ce urmează listelor curge în
    aceeași voce.
*/}
<Sectiune id="problema" latime="larg">
  <div class="perechi">
    <div class="pereche">
      <h2 data-reveal>{problema.h2}</h2>
      <ul class="lista">
        {problema.exemple.map((linie) => (
          <li data-reveal>{linie}</li>
        ))}
      </ul>
    </div>

    <div class="pereche">
      <h2 data-reveal>{problema.intrebariIntro}</h2>
      <ul class="lista">
        {problema.intrebari.map((linie) => (
          <li data-reveal>{linie}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="concluzie-bloc" data-reveal>
    {problema.concluzie.map((p) => (
      <p class="concluzie">{p}</p>
    ))}
  </div>
</Sectiune>

<style>
  /*
   * Cele două intro-uri sunt la ACELAȘI nivel — cerut direct („«Iar
   * întrebările care nu-ți dau pace sunt:» trebuie să fie la nivelul «Simți
   * că unele aspecte...»"). Sunt amândouă `h2`, nu doar la fel la privire:
   * dacă arată ca titlu, e titlu și pentru un cititor de ecran. Precedent în
   * pagină — `S04PentruCine.astro` are tot două `h2` în aceeași secțiune.
   *
   * `--t-h2`, nu `--t-statement`: pe două coloane, declarația mare (până la
   * 3rem) umplea coloana cu 4-5 rânduri de titlu și lăsa lista să pară o
   * notă de subsol. `--t-h2` (max 2.25rem) ține perechea titlu+listă
   * echilibrată în interiorul coloanei.
   */
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
    text-wrap: balance;
  }

  /*
   * Echilibrul secțiunii, cerut în aceeași propoziție („echilibrează pagina
   * și secțiunea"). Problema declara `latime="larg"` (62rem) dar stivuia tot
   * într-o singură coloană plafonată la `--max-proza` (38rem) — pe desktop
   * rămânea un gol de ~40% în dreapta, în timp ce vecinele ei `larg`
   * (PentruCine, Soluție, Rezultatul) își umplu lățimea cu grile. Acum cele
   * două perechi titlu+listă stau una lângă alta și chiar folosesc lățimea
   * declarată. Pe mobil, aceeași grilă se stivuiește — nicio schimbare.
   */
  .perechi {
    display: grid;
    gap: var(--sp-xl);
  }

  @media (min-width: 52rem) {
    .perechi {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-2xl);
      align-items: start;
    }
  }

  /* Fost `.exemple` — refolosită acum pentru AMBELE liste (simptome ȘI
     întrebări): același marcaj, aceeași culoare. Distincția dintre ele vine
     din titlul de deasupra fiecăreia, nu dintr-un stil vizual separat. */
  .lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-sm);
    max-width: var(--max-proza);
  }

  .lista li {
    display: grid;
    /* Bulina e mult mai îngustă decât fostul em-dash — coloana de marcaj
       scade odată cu ea, altfel textul rămâne împins inutil spre dreapta. */
    grid-template-columns: 1.1rem 1fr;
    align-items: baseline;
    font-size: var(--t-corp-lg);
    line-height: var(--lh-normal);
  }

  /* Bulină, cerută explicit (2026-09-07). `::before`, nu `list-style`/`::marker`:
     `li` e `display: grid` (ca să țină marcajul și textul în două coloane, cu
     rândurile 2+ aliniate sub prima literă, nu sub bulină) — iar un element
     grid nu mai randează marcajul nativ de listă în toate motoarele. */
  .lista li::before {
    content: '•';
    color: var(--accent-decor);
    font-size: 1.15em;
    line-height: 1;
  }

  /*
   * Fără linie de separare și fără propoziție „mare" la final — cerut direct:
   * textul primit e O secțiune, nu două. Concluzia curge din liste ca un
   * paragraf normal, la aceeași greutate. Singura diferență față de rândurile
   * de listă e mărimea de corp (`--t-corp`, nu `--t-corp-lg`): listele sunt
   * enumerarea, asta e proza care le comentează.
   */
  .concluzie-bloc {
    margin-top: var(--sp-lg);
    display: grid;
    gap: var(--sp-xs);
  }

  .concluzie {
    max-width: var(--max-proza);
    color: var(--secundar);
    line-height: var(--lh-normal);
  }
</style>
