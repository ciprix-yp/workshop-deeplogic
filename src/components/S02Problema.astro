---
import { problema } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

{/*
  Cea mai importantă secțiune a paginii. Nu se taie la mobil, indiferent ce —
  regulă neschimbată de pivotul de structură (2026-09-02). Rescrisă complet:
  deschide direct cu exemple concrete, nu cu un bloc de „vacarm" separat —
  absoarbe spiritul fostului grid de exemple (retras ca secțiune proprie).
*/}
<Sectiune id="problema" latime="larg">
  <h2 data-reveal>{problema.h2}</h2>

  <ul class="exemple">
    {problema.exemple.map((linie) => (
      <li data-reveal>{linie}</li>
    ))}
  </ul>

  <p class="sau-poate" data-reveal>{problema.sauPoate}</p>

  <div class="intre-timp">
    {problema.intreTimp.map((p) => (
      <p data-reveal>{p}</p>
    ))}
  </div>

  <div class="intrebare-bloc" data-reveal>
    <p class="intrebare">{problema.intrebare}</p>
    <p class="intrebare-sub">{problema.intrebareSub}</p>
  </div>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-statement);
    max-width: 20ch;
    margin-bottom: var(--sp-lg);
  }

  .exemple {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-sm);
    max-width: var(--max-proza);
  }

  .exemple li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    align-items: baseline;
    font-size: var(--t-corp-lg);
    line-height: var(--lh-normal);
  }

  .exemple li::before {
    content: '—';
    color: var(--accent-decor);
    font-weight: 600;
  }

  .sau-poate {
    margin-top: var(--sp-md);
    max-width: var(--max-proza);
    color: var(--text-muted);
    line-height: var(--lh-normal);
  }

  .intre-timp {
    margin-top: var(--sp-xl);
    display: grid;
    gap: var(--sp-xs);
    max-width: var(--max-proza);
  }

  .intrebare-bloc {
    margin-top: var(--sp-xl);
    padding-top: var(--sp-lg);
    border-top: 1px solid rgba(47, 79, 79, 0.18);
  }

  .intrebare {
    font-family: var(--font-titlu);
    font-weight: 700;
    font-size: var(--t-h2);
    max-width: 20ch;
  }

  .intrebare-sub {
    margin-top: var(--sp-xs);
    max-width: var(--max-proza);
    color: var(--secundar);
    line-height: var(--lh-normal);
  }
</style>
