---
import { faq } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

{/*
  Ultimele obiecții, chiar înainte de CTA-ul final.

  Accordion (pivot 2026-09-02) — reversare deliberată a regulii anterioare
  („fără accordion, un click în plus pe obiecția decisivă e un click pe
  care mulți nu-l fac"). Cerut explicit de Ciprian. `<details>`/`<summary>`
  nativ: funcționează fără JS, navigabil cu tastatura fără cod suplimentar.
*/}
<Sectiune id="intrebari">
  <h2 data-reveal>{faq.h2}</h2>

  <div class="lista">
    {faq.intrebari.map((item) => (
      <details class="qa" data-reveal>
        <summary>
          <span class="q">{item.q}</span>
          <svg class="chevron" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="a-wrap">
          <p class="a">{item.a}</p>
        </div>
      </details>
    ))}
  </div>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  .lista {
    display: grid;
  }

  .qa {
    border-bottom: 1px solid rgba(47, 79, 79, 0.15);
  }

  .qa:first-child {
    border-top: 1px solid rgba(47, 79, 79, 0.15);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-md);
    padding-block: var(--sp-sm);
    cursor: pointer;
    list-style: none;
    /* Țintă de atingere reală — întrebarea întreagă e clicabilă, nu doar
       chevron-ul. */
    min-height: var(--touch);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::marker {
    content: '';
  }

  summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius);
  }

  .q {
    font-family: var(--font-titlu);
    font-weight: 600;
    font-size: var(--t-corp-lg);
    line-height: var(--lh-normal);
    letter-spacing: -0.01em;
  }

  .chevron {
    flex: none;
    color: var(--accent);
    transition: transform 0.2s var(--ease-out);
  }

  .qa[open] .chevron {
    transform: rotate(180deg);
  }

  /*
   * Animație CSS-only, fără JS — `display: grid` explicit învinge regula
   * implicită a browserului (`details:not([open]) > *:not(summary) {
   * display: none }`), deci conținutul rămâne mereu în grid, doar rândul
   * lui trece de la 0fr la 1fr. `overflow: hidden` pe copil, nu pe wrapper,
   * ca `padding-bottom`-ul răspunsului să nu se taie la tranziția finală.
   */
  .a-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s var(--ease-out);
  }

  .qa[open] .a-wrap {
    grid-template-rows: 1fr;
  }

  .a {
    overflow: hidden;
    min-height: 0;
    margin: 0;
    padding-bottom: var(--sp-md);
    color: var(--secundar);
    line-height: var(--lh-normal);
  }
</style>
