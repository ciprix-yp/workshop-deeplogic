---
import { faq } from '../content/copy';
import Sectiune from './Sectiune.astro';
---

{/*
  Ultimele obiecții, chiar înainte de CTA-ul final.

  Deliberat FĂRĂ accordion. Un `<details>` închis ascunde exact răspunsurile
  care conving — inclusiv „O să-mi vindeți ceva la final?", cea mai importantă
  din listă. Un click în plus pe obiecția decisivă e un click pe care mulți
  nu-l fac. Sunt șapte întrebări scurte; se citesc.
*/}
<Sectiune id="intrebari">
  <h2>{faq.h2}</h2>

  <dl>
    {faq.intrebari.map((item) => (
      <div class="qa">
        <dt>{item.q}</dt>
        <dd>{item.a}</dd>
      </div>
    ))}
  </dl>
</Sectiune>

<style>
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--sp-md);
  }

  /* Retunat (iterația 2, QA #2; strâns din nou pentru „un ecran" pe mobil):
     sp-lg (32px) → sp-md (20px) → sp-sm (12px) — 7 întrebări scurte, nu 7
     secțiuni; era cel mai mare contribuitor singular la lungimea cardului. */
  dl {
    margin: 0;
    display: grid;
    gap: var(--sp-sm);
  }

  .qa {
    display: grid;
    gap: var(--sp-2xs);
  }

  dt {
    font-family: var(--font-titlu);
    font-weight: 600;
    font-size: var(--t-corp-lg);
    line-height: var(--lh-normal);
    letter-spacing: -0.01em;
  }

  dd {
    margin: 0;
    color: var(--secundar);
    /* lh-normal, nu lh-lejer (implicit de pe body): răspunsurile sunt proză
       scurtă (2-3 propoziții), nu text lung de citit în bloc — același
       raționament ca `.subheadline`/`.pentru-cine` din S01Hero.astro.
       Recuperă spațiu vertical real pe răspunsurile de 3-4 rânduri. */
    line-height: var(--lh-normal);
  }
</style>
