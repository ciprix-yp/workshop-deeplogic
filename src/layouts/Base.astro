---
import '../styles/fonts.css';
import '../styles/tokens.css';
import { meta, EVENIMENT, footer } from '../content/copy';
import BaraScarcity from '../components/BaraScarcity.astro';

interface Props {
  titlu?: string;
  descriere?: string;
  /** Paginile de răspuns (confirmare, anulare, check-in) nu se indexează. */
  noindex?: boolean;
  /**
   * Bara de scarcity (locuri + countdown) — doar pagina de landing. Găsit la
   * audit (impeccable, 2026-09-01): montată necondiționat înainte, rula și
   * pe /checkin, /multumesc, /raspuns etc., unde numărul n-are sens și
   * pollingul de 20s continuă cât timp tab-ul stă deschis degeaba.
   */
  scarcity?: boolean;
  /** Lenis + GSAP ScrollTrigger — doar unde chiar există ceva de animat (§06, index.astro). */
  motion?: boolean;
  /**
   * Reveal la scroll (`[data-reveal]`, vezi Sectiune.astro) + înclinare la
   * cursor pe carduri (`[data-tilt]`) — pivot 2026-09-02, linia vizuală
   * "Roxana Tascu". Doar pagina de landing (index.astro), la fel ca `motion`.
   */
  depth?: boolean;
}

const {
  titlu = meta.titlu,
  descriere = meta.descriere,
  noindex = false,
  scarcity = false,
  motion = false,
  depth = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://workshop.deeplogic.ro';
const urlCanonic = new URL(Astro.url.pathname, siteUrl).toString();
// og:image trebuie să fie absolut — WhatsApp și LinkedIn nu rezolvă căi relative.
const ogImagineAbsolut = new URL(meta.ogImagine, siteUrl).toString();

/**
 * JSON-LD. Ora e scrisă cu offset explicit: pe 16 septembrie România e în EEST
 * (UTC+3). Fără offset, Google interpretează ca UTC și afișează 17:00.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: EVENIMENT.titlu,
  description: meta.descriere,
  startDate: '2026-09-16T14:00:00+03:00',
  endDate: '2026-09-16T17:00:00+03:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  inLanguage: 'ro-RO',
  maximumAttendeeCapacity: EVENIMENT.capacitate,
  image: [ogImagineAbsolut],
  location: {
    '@type': 'Place',
    name: EVENIMENT.locatie,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Strada 1 Decembrie 1918 nr. 1',
      addressLocality: 'Satu Mare',
      postalCode: '440010',
      addressCountry: 'RO',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: EVENIMENT.organizator,
    url: footer.website,
  },
  performer: { '@type': 'Person', name: 'Ciprian Micu' },
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'RON',
    availability: 'https://schema.org/InStock',
    url: urlCanonic,
    validFrom: '2026-08-27T00:00:00+03:00',
  },
};
---

<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={urlCanonic} />
    <title>{titlu}</title>
    <meta name="description" content={descriere} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Marchează prezența JS-ului ÎNAINTE de primul paint — `[data-reveal]`
      din tokens.css se ascunde DOAR sub `html.js`, exact tehnica `.cu-js`
      din DialogInscriere.astro. Fără ea, un vizitator fără JS ar vedea
      conținut ascuns permanent (nimic nu ar mai adăuga `.e-vizibil`).
    */}
    {depth && <script is:inline>document.documentElement.classList.add('js');</script>}

    {/*
      Peste 40% din trafic vine dintr-un link lipit în WhatsApp de un membru
      BIZZ.CLUB. Cardul de preview e primul lucru pe care îl vede invitatul, în
      momentul în care membrul își pune reputația la bătaie („ți-o dau ție").
      Un link fără card arată a spam.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={EVENIMENT.organizator} />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:title" content={meta.ogTitlu} />
    <meta property="og:description" content={meta.ogDescriere} />
    <meta property="og:url" content={urlCanonic} />
    <meta property="og:image" content={ogImagineAbsolut} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${EVENIMENT.titlu} — ${EVENIMENT.dataScurt}, ${EVENIMENT.oras}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitlu} />
    <meta name="twitter:description" content={meta.ogDescriere} />
    <meta name="twitter:image" content={ogImagineAbsolut} />

    {/*
      Preîncărcăm doar Inter — H1-ul din hero e elementul LCP, iar textul lui
      („Toată lumea îți spune să adopți AI.") conține ă/î/ț, deci are nevoie
      și de latin-ext, nu doar de latin. Corpul paginii se încarcă prin swap.
    */}
    <link rel="preload" href="/fonts/inter-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400-700-latin-ext.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#376A66" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body class:list={[scarcity && 'cu-scarcity']}>
    <a class="skip" href="#continut">Sari la conținut</a>
    {scarcity && <BaraScarcity />}
    <slot />

    {/*
      Lenis + GSAP — doar pe pagina de landing (`motion` prop, vezi
      index.astro). Pivot de arhitectură deliberat (2026-09-01, Ciprian):
      motorul de scroll custom (MotionEngine.astro + docs/design/storyboard.json,
      opt de scene coregrafiate individual) e retras în favoarea Lenis
      (scroll cu inerție) + GSAP ScrollTrigger, folosit DOAR în §06 CeFacem
      (cei cinci pași ai metodologiei — vezi scriptul din S06CeFacem.astro).
      Restul paginii rămâne static, fără fade-up, fără tilt pe carduri —
      cost acceptat: JS real (Lenis + GSAP), nu mai 0KB, în schimbul
      scroll-ului cu inerție și al unui pin/scrub matur pe singura secțiune
      care încă animă la scroll.

      Găsit la audit (impeccable, 2026-09-01): înainte se monta necondiționat
      în Base.astro, deci `/checkin`, `/multumesc`, `/raspuns` etc. plăteau
      costul bundle-ului (Lenis+GSAP+ScrollTrigger) și rulau un RAF loop
      permanent fără niciun pin/scrub de sincronizat — zero beneficiu vizual.

      Script de MODUL (nu `is:inline`): are nevoie de `import`-uri npm, pe
      care bundler-ul Vite le rezolvă doar pentru scripturi procesate.
    */}
    {motion && (
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const lenis = new Lenis({
        autoRaf: false,
        // Fix (audit impeccable, 2026-09-01): `anchors: true` făcea Lenis să
        // intercepteze ȘI clickurile pe CTA-uri (`href="#inscriere"`), peste
        // interceptarea proprie din DialogInscriere.astro — care cheamă deja
        // `preventDefault()` + `showModal()`. Lenis nu verifică
        // `event.defaultPrevented` (verificat direct în sursă), deci ambele
        // rulau: dialogul se deschidea ȘI pagina săgeta spre `#inscriere`
        // (acum un `<dialog>` închis, fără poziție reală de scroll) — un
        // scroll vizibil, nedorit, la fiecare click de CTA. Singura ancoră
        // reală rămasă e `#continut` (skip-link), pentru care un salt nativ,
        // instant, e oricum comportamentul corect de accesibilitate — nu
        // unul animat.
        // Respectă mișcarea redusă la firul ei, nu doar la salturi
        // programatice: `respectReducedMotion` (implicit `true` în Lenis)
        // afectează DOAR `scrollTo()`, nu scroll-ul obișnuit de la rotița
        // mouse-ului/gest tactil (verificat în sursă) — fără asta, cineva
        // cu „prefers-reduced-motion" tot primea scroll cu inerție.
        smoothWheel: !reduceMotion,
        syncTouch: false,
      });

      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
    </script>
    )}

    {/*
      Reveal la scroll + tilt pe carduri (`depth` prop) — vanilla, fără GSAP:
      efectul e un simplu fade+ridicare la intrarea în viewport și o
      înclinare 3D la cursor, niciunul n-are nevoie de motorul de scroll —
      adăugarea lui GSAP peste asta ar fi cost fără beneficiu (regula rămâne
      neschimbată: GSAP trăiește STRICT în §06CeFacem).
    */}
    {depth && (
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ── Reveal la scroll: fiecare element, o singură dată ────────────────
      const revealuri = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (!reduceMotion && revealuri.length && 'IntersectionObserver' in window) {
        const observator = new IntersectionObserver(
          (intrari) => {
            for (const intrare of intrari) {
              if (!intrare.isIntersecting) continue;
              intrare.target.classList.add('e-vizibil');
              observator.unobserve(intrare.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
        );
        revealuri.forEach((el) => observator.observe(el));
      } else {
        // Mișcare redusă sau fără IntersectionObserver: totul vizibil direct.
        revealuri.forEach((el) => el.classList.add('e-vizibil'));
      }

      // ── Tilt 3D la cursor — doar pointer fin, cu hover real ──────────────
      const inclinabile = Array.from(document.querySelectorAll<HTMLElement>('[data-tilt]'));
      const arePointerFin = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (!reduceMotion && arePointerFin && inclinabile.length) {
        const GRADE_MAX = 8;
        inclinabile.forEach((card) => {
          card.addEventListener('mousemove', (ev) => {
            const r = card.getBoundingClientRect();
            const x = (ev.clientX - r.left) / r.width - 0.5;
            const y = (ev.clientY - r.top) / r.height - 0.5;
            card.style.setProperty('--ry', `${x * GRADE_MAX * 2}deg`);
            card.style.setProperty('--rx', `${y * -GRADE_MAX * 2}deg`);
          });
          card.addEventListener('mouseleave', () => {
            card.style.setProperty('--rx', '0deg');
            card.style.setProperty('--ry', '0deg');
          });
        });
      }
    </script>
    )}
  </body>
</html>

<style>
  /*
    Link de sărire peste navigare. Vizibil doar la focus de tastatură — nu are
    cost vizual, dar e diferența dintre „pot naviga" și „nu pot" pentru cineva
    care ajunge la formular cu Tab.
  */
  .skip {
    position: absolute;
    left: var(--sp-md);
    top: -100%;
    z-index: 100;
    background: var(--accent);
    color: #fff;
    padding: var(--sp-sm) var(--sp-md);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    transition: top 0.15s ease;
  }
  .skip:focus {
    top: var(--sp-md);
  }
  /* Doar când bara chiar există (pagina de landing) — vezi `.cu-scarcity`
     global mai jos. Altfel, `.skip:focus` ar coborî cu înălțimea unei bare
     care nu se randează pe pagina asta. */
  :global(body.cu-scarcity) .skip:focus {
    top: calc(var(--h-bara-scarcity) + var(--sp-md));
  }
</style>

<style is:global>
  /* Bara de scarcity e fixă, deasupra fluxului normal — fără padding pe
     body, hero-ul (primul element al paginii) ar începe acoperit de ea.
     Doar pe pagina cu bară (`scarcity` prop, vezi index.astro) — altfel
     paginile fără ea (/checkin, /multumesc etc.) ar căpăta un gol gol sus. */
  body.cu-scarcity {
    padding-top: var(--h-bara-scarcity);
  }
</style>
