# Copiază în `.dev.vars` (pentru wrangler dev) și `.env` (pentru astro dev).
# Niciunul din cele două nu intră în git — vezi .gitignore.
#
# În producție, secretele se pun cu:  wrangler secret put <NUME>

# ── Supabase ────────────────────────────────────────────────────────────────
# Service role key. NU anon key — spec-ul cere ca `anon` să n-aibă drepturi pe
# niciun tabel, iar toată scrierea să treacă prin API routes.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Cratimă simplă, nu „·" — randare universală în orice client de mail.
# Trebuie să corespundă semnăturii din docs/EMAILURI.md.
EMAIL_FROM="Ciprian Micu - Deep Logic <ciprian@deeplogic.ro>"
# Unde ajung alertele când reconcilierea găsește înscrieri fără email trimis.
ALERT_EMAIL=

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
# Chei de test Cloudflare (trec întotdeauna) — pentru dev:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Inngest ─────────────────────────────────────────────────────────────────
# Goale în dev — Inngest Dev Server nu le cere.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:4321
